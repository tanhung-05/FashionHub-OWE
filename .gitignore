## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Visual Studio / VS Code
.vs/
.vscode/
*.code-workspace

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleasePublic/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET / ASP.NET
artifacts/
TestResults/
*.trx
*.coverage
*.coveragexml
*.pdb
*.cache
*.log
appsettings.Development.json

# NuGet
packages/
*.nupkg
*.snupkg
.nuget/
project.lock.json
project.assets.json

# Node / frontend tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
.tmp/
.cache/

# SQL Server / local databases
*.mdf
*.ldf
*.ndf

# Docker / local environment
.env
.env.*
!.env.example

# OS generated files
.DS_Store
Thumbs.db
desktop.ini