@model IEnumerable<FashionHub.Models.DanhMuc>

@{
    var parentCategories = Model.Where(c => c.IDDanhMucCha == null).ToList();

    // Lấy Controller và Action hiện tại
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Hàm helper kiểm tra nếu link hiện tại là active
    Func<string, string, string> isActive = (controller, action) =>
    {
        return (currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) && 
                currentAction.Equals(action, StringComparison.OrdinalIgnoreCase)) 
            ? "active" 
            : "";
    };
}

<!-- TRANG CHỦ - Active động -->
<li class="nav-item">
    <a class="nav-link @isActive("Home", "Index")" aria-current="page" href="@Url.Action("Index", "Home")">Trang chủ</a>
</li>

<!-- DROPDOWN DANH MỤC SẢN PHẨM -->
<li class="nav-item dropdown nav-products">
    <a class="nav-link dropdown-toggle hide-arrow @isActive("Products", "Index")"
       href="@Url.Action("Index", "Products")"
       id="categoryDropdown"
       role="button"
       data-bs-toggle="dropdown"
       aria-expanded="false">
        Sản phẩm
    </a>
    <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
        @foreach (var parent in parentCategories)
        {
            var childCategories = Model.Where(c => c.IDDanhMucCha == parent.IDDanhMuc).ToList();

            if (childCategories.Any())
            {
                <li class="dropdown-submenu">
                    <a class="dropdown-item d-flex justify-content-between align-items-center"
                       href="@Url.Action("Index", "Products", new { categoryId = parent.IDDanhMuc })">
                        <span>@parent.TenDanhMuc</span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <ul class="dropdown-menu">
                        @foreach (var child in childCategories)
                        {
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Products", new { categoryId = child.IDDanhMuc })">@child.TenDanhMuc</a></li>
                        }
                    </ul>
                </li>
            }
            else
            {
                <li><a class="dropdown-item" href="@Url.Action("Index", "Products", new { categoryId = parent.IDDanhMuc })">@parent.TenDanhMuc</a></li>
            }
        }
    </ul>
</li>

<!-- BLOG -->
<li class="nav-item">
    <a class="nav-link" href="#">Blog</a>
</li>

<!-- LIÊN HỆ -->
<li class="nav-item">
    <a class="nav-link" href="#">Liên hệ</a>
</li>
