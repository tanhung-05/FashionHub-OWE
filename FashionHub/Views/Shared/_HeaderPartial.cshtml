@{
    var currentUser = Session["User"] as FashionHub.Models.NguoiDung;
}

<nav class="navbar navbar-expand-lg navbar-light fixed-top bg-white transition-all main-navbar" id="mainHeader">
    <div class="container">
        <a class="navbar-brand fw-bold fs-3 text-uppercase ls-1" href="@Url.Action("Index", "Home")">
            OWE
        </a>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Mo menu">
            <i class="bi bi-list fs-2"></i>
        </button>

        <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title fw-bold" id="offcanvasNavbarLabel">MENU</h5>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Dong menu"></button>
            </div>

            <div class="offcanvas-body d-flex flex-column flex-lg-row align-items-lg-center">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-semibold text-uppercase gap-3">
                    @{ Html.RenderAction("_MenuPartial", "Home"); }
                </ul>

                <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                    <form action="@Url.Action("Index", "Products")" method="get" class="search-form position-relative d-none d-lg-block">
                        <div class="input-group input-group-sm border rounded-pill overflow-hidden bg-light">
                            <input type="text"
                                   id="main-search-input"
                                   name="searchString"
                                   class="form-control border-0 bg-transparent shadow-none ps-3"
                                   placeholder="T&#236;m ki&#7871;m ho&#7863;c d&#225;n &#7843;nh..."
                                   value="@Request.QueryString["searchString"]"
                                   autocomplete="off">

                            <button class="btn btn-link text-secondary border-0 px-2" type="button" id="btn-trigger-image-search" title="Tim bang hinh anh" aria-label="Tim bang hinh anh">
                                <i class="bi bi-camera"></i>
                            </button>

                            <button class="btn btn-link text-dark border-0 pe-3" type="submit" aria-label="Tim kiem">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    @using (Html.BeginForm("SearchByImage", "Products", FormMethod.Post, new { enctype = "multipart/form-data", id = "image-search-form", @class = "d-none" }))
                    {
                        <input type="file" name="imageFile" id="hidden-file-input" accept="image/*">
                    }

                    <a href="@Url.Action("Index", "Products")" class="text-dark d-lg-none fs-5" aria-label="Tim kiem">
                        <i class="bi bi-search"></i>
                    </a>

                    @if (currentUser != null)
                    {
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none text-dark dropdown-toggle hide-arrow" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tai khoan">
                                <i class="bi bi-person-circle fs-4"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-3" aria-labelledby="userDropdown">
                                <li>
                                    <div class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-truncate header-user-name">@currentUser.HoTen</div>
                                        <div class="text-muted small text-truncate header-user-email">@currentUser.Email</div>
                                    </div>
                                </li>
                                <li><a class="dropdown-item py-2" href="@Url.Action("UserProfile", "Account")"><i class="bi bi-person-vcard me-2"></i>H&#7891; s&#417;</a></li>
                                <li><a class="dropdown-item py-2" href="@Url.Action("Index", "ManageOrder")"><i class="bi bi-receipt me-2"></i>&#272;&#417;n h&#224;ng</a></li>

                                @if (currentUser.IDVaiTro == 1)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item fw-bold text-primary" href="@Url.Action("Index", "Home", new { area = "Admin" })"><i class="bi bi-speedometer2 me-2"></i>Qu&#7843;n tr&#7883;</a></li>
                                }

                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <a class="dropdown-item text-danger py-2" href="javascript:document.getElementById('logoutForm').submit()">
                                            <i class="bi bi-box-arrow-right me-2"></i>&#272;&#259;ng xu&#7845;t
                                        </a>
                                    }
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="btn btn-dark btn-sm rounded-pill px-3">&#272;&#259;ng nh&#7853;p</a>
                    }

                    <div class="position-relative">
                        @{ Html.RenderAction("CartIcon", "Cart"); }
                    </div>
                </div>
            </div>
        </div>
    </div>
</nav>