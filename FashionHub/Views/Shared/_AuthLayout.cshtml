<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FashionHub</title>
    @Styles.Render("~/Content/css")
    <style>
        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(17, 17, 17, 0.08), transparent 30%),
                linear-gradient(135deg, #f7f3ed 0%, #ffffff 52%, #eee7dd 100%);
        }

        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
        }

        .auth-wrapper main {
            width: 100%;
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>