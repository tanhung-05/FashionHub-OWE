@model FashionHub.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <a href="@Url.Action("Index", "Home")" class="auth-logo" aria-label="OWE">OWE</a>
        <p>Thời trang tối giản cho phong cách hiện đại</p>
    </div>

    <div class="card border-0 shadow-lg">
        <div class="card-body p-4 p-md-5">
            <div class="auth-heading text-center mb-4">
                <span class="auth-eyebrow">Welcome back</span>
                <h1>Đăng nhập</h1>
                <p>Tiếp tục mua sắm và quản lý đơn hàng của bạn.</p>
            </div>

            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "auth-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                <div class="form-floating mb-3">
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "name@example.com", autocomplete = "email" })
                    @Html.LabelFor(m => m.Email)
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="form-floating mb-3">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mật khẩu", autocomplete = "current-password" })
                    @Html.LabelFor(m => m.Password)
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                    <a class="auth-link small" href="#">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn btn-primary w-100 auth-submit">Đăng nhập</button>
            }
        </div>

        <div class="card-footer text-center bg-white border-0 px-4 pb-4">
            <span class="text-muted small">Chưa có tài khoản?</span>
            <a class="auth-link small fw-bold" href="@Url.Action("Register", new { returnUrl = ViewBag.ReturnUrl })">Đăng ký ngay</a>
        </div>
    </div>
</div>