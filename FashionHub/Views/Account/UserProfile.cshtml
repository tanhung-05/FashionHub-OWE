@model FashionHub.ViewModels.ProfileViewModel
@{
    ViewBag.Title = "Tài khoản của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Dùng layout chung
}

<div class="container py-5">
    <h2 class="mb-4 text-center">Quản lý tài khoản</h2>

    <div class="row">
        <!-- CỘT TRÁI: THÔNG TIN CÁ NHÂN -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>Thông tin cá nhân</h5>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @using (Html.BeginForm("UserProfile", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label text-muted">Email đăng nhập</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light", @readonly = "readonly" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.HoTen, "Họ và tên", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.SoDienThoai, "Số điện thoại", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger" })
                        </div>

                        <button type="submit" class="btn btn-dark w-100">
                            <i class="bi bi-save me-2"></i>Lưu thay đổi
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: CÁC MỤC QUẢN LÝ KHÁC -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-grid-fill me-2"></i>Tiện ích quản lý</h5>
                </div>
                <div class="list-group list-group-flush">
                    <!-- Link tới Đơn hàng -->
                    <a href="@Url.Action("Index", "ManageOrder")" class="list-group-item list-group-item-action py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-receipt text-primary me-2 fs-5"></i>
                            <span class="fw-bold">Đơn hàng của tôi</span>
                            <div class="text-muted small ms-4">Xem lịch sử mua hàng và trạng thái đơn</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <!-- Link tới Sổ địa chỉ -->
                    <a href="@Url.Action("Addresses", "Account")" class="list-group-item list-group-item-action py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-geo-alt text-success me-2 fs-5"></i>
                            <span class="fw-bold">Sổ địa chỉ</span>
                            <div class="text-muted small ms-4">Quản lý địa chỉ giao hàng mặc định</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <!-- Link tới Đổi mật khẩu -->
                    <a href="@Url.Action("ChangePassword", "Account")" class="list-group-item list-group-item-action py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-shield-lock text-warning me-2 fs-5"></i>
                            <span class="fw-bold">Bảo mật tài khoản</span>
                            <div class="text-muted small ms-4">Đổi mật khẩu đăng nhập</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>