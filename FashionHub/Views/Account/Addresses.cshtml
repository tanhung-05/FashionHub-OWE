@model IEnumerable<FashionHub.Models.DiaChi>
@{ ViewBag.Title = "Sổ địa chỉ"; }

<div class="container my-4">
    <h2 class="mb-4">Sổ địa chỉ của tôi</h2>

    <!-- Nút mở Modal -->
    <button class="btn btn-primary mb-4" data-bs-toggle="modal" data-bs-target="#addAddressModal">
        <i class="bi bi-plus-lg"></i> Thêm địa chỉ mới
    </button>

    <div class="row" id="address-list">
        @foreach (var addr in Model)
        {
            <div class="col-md-6 mb-4" id="address-card-@addr.IDDiaChi">
                <div class="card h-100 shadow-sm @(addr.LaMacDinh == true ? "border-primary" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title fw-bold">@addr.TenNguoiNhan</h5>
                            @if (addr.LaMacDinh == true)
                            {
                                <span class="badge bg-primary">Mặc định</span>
                            }
                        </div>

                        <!-- Hiển thị địa chỉ dùng các thuộc tính có số 1 như trong ảnh Model của bạn -->
                        <p class="card-text mb-1 text-muted">
                            @addr.ChiTiet, @addr.PhuongXa1, @addr.QuanHuyen1, @addr.TinhThanh1
                        </p>
                        <p class="card-text"><strong>SĐT:</strong> @addr.SoDienThoai</p>

                        <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                            <a href="#" class="text-danger text-decoration-none btn-delete-address" data-id="@addr.IDDiaChi">
                                <i class="bi bi-trash"></i> Xóa
                            </a>

                            @if (addr.LaMacDinh != true)
                            {
                                <a href="#" class="text-primary text-decoration-none btn-set-default" data-id="@addr.IDDiaChi">
                                    Đặt làm mặc định
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@Html.Partial("_AddAddressModalPartial")

@section scripts {
    <script>
        $(document).ready(function () {
            // --- 1. LOGIC API ĐỊA CHÍNH (ESGOO.NET) ---

            // Load Tỉnh
            $.getJSON('https://esgoo.net/api-tinhthanh/1/0.htm', function (data_tinh) {
                if (data_tinh.error == 0) {
                    $.each(data_tinh.data, function (key_tinh, val_tinh) {
                        $("#api_tinh").append('<option value="' + val_tinh.id + '">' + val_tinh.full_name + '</option>');
                    });
                }
            });

            // Chọn Tỉnh -> Load Huyện
            $("#api_tinh").change(function (e) {
                var idtinh = $(this).val();
                var tentinh = $("#api_tinh option:selected").text();
                $("#hidden_tinh").val(tentinh);

                $("#api_huyen").html('<option value="">-- Chọn Quận/Huyện --</option>').prop('disabled', true);
                $("#api_xa").html('<option value="">-- Chọn Phường/Xã --</option>').prop('disabled', true);

                if (idtinh) {
                    $.getJSON('https://esgoo.net/api-tinhthanh/2/' + idtinh + '.htm', function (data_huyen) {
                        if (data_huyen.error == 0) {
                            $.each(data_huyen.data, function (key_huyen, val_huyen) {
                                $("#api_huyen").append('<option value="' + val_huyen.id + '">' + val_huyen.full_name + '</option>');
                            });
                            $("#api_huyen").prop('disabled', false);
                        }
                    });
                }
            });

            // Chọn Huyện -> Load Xã
            $("#api_huyen").change(function (e) {
                var idhuyen = $(this).val();
                var tenhuyen = $("#api_huyen option:selected").text();
                $("#hidden_huyen").val(tenhuyen);

                $("#api_xa").html('<option value="">-- Chọn Phường/Xã --</option>').prop('disabled', true);

                if (idhuyen) {
                    $.getJSON('https://esgoo.net/api-tinhthanh/3/' + idhuyen + '.htm', function (data_xa) {
                        if (data_xa.error == 0) {
                            $.each(data_xa.data, function (key_xa, val_xa) {
                                $("#api_xa").append('<option value="' + val_xa.id + '">' + val_xa.full_name + '</option>');
                            });
                            $("#api_xa").prop('disabled', false);
                        }
                    });
                }
            });

            // Chọn Xã -> Lưu tên
            $("#api_xa").change(function (e) {
                var tenxa = $("#api_xa option:selected").text();
                $("#hidden_xa").val(tenxa);
            });

            // --- 2. LOGIC LƯU ĐỊA CHỈ ---
            var addAddressModal = new bootstrap.Modal(document.getElementById('addAddressModal'));

            $('#save-address-btn').on('click', function () {
                var form = $('#add-address-form');
                var btn = $(this);

                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Đang lưu...');

                var data = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    tenNguoiNhan: $('#tenNguoiNhan').val(),
                    soDienThoai: $('#soDienThoai').val(),
                    chiTiet: $('#chiTiet').val(),
                    tinhThanh: $('#hidden_tinh').val(),
                    quanHuyen: $('#hidden_huyen').val(),
                    phuongXa: $('#hidden_xa').val()
                };

                $.post('/Account/AddAddressAjax', data, function (response) {
                    if (response.success) {
                        // Reload trang để cập nhật danh sách
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                }).always(function () {
                    btn.prop('disabled', false).text('Lưu địa chỉ');
                });
            });

            // --- 3. XÓA & ĐẶT MẶC ĐỊNH ---
            $(document).on('click', '.btn-delete-address', function(e){
                e.preventDefault();
                if(confirm('Bạn có chắc muốn xóa địa chỉ này?')){
                    var id = $(this).data('id');
                    $.post('@Url.Action("DeleteAddress")', { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(), id: id }, function(res){
                        if(res.success){
                            $('#address-card-' + id).remove();
                        }
                    });
                }
            });

            $(document).on('click', '.btn-set-default', function(e){
                e.preventDefault();
                var id = $(this).data('id');
                $.post('@Url.Action("SetDefaultAddress")', { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(), id: id }, function(res){
                    if(res.success){
                        location.reload();
                    }
                });
            });
        });
    </script>
}