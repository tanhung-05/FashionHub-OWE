@{
    ViewBag.Title = "Đơn hàng của tôi";
}
@Html.AntiForgeryToken()
<div class="container my-5">
    <h2 class="text-center mb-4">Đơn hàng của tôi</h2>

    <!-- Hệ thống Tabs -->
    <ul class="nav nav-pills justify-content-center mb-4" id="order-status-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-status-id="">Tất cả <span class="badge bg-secondary">@ViewBag.AllCount</span></button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-status-id="0">Chờ xác nhận <span class="badge bg-secondary">@ViewBag.WaitingCount</span></button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-status-id="1">Đang xử lý <span class="badge bg-secondary">@ViewBag.ProcessingCount</span></button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-status-id="2">Đang giao <span class="badge bg-secondary">@ViewBag.ShippingCount</span></button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-status-id="3">Hoàn thành <span class="badge bg-secondary">@ViewBag.CompletedCount</span></button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-status-id="4">Đã hủy <span class="badge bg-secondary">@ViewBag.CancelledCount</span></button>
        </li>
    </ul>

    <!-- Container để load danh sách đơn hàng -->
    <div id="order-list-container">
        <!-- Hiển thị loading spinner ban đầu -->
        <div class="text-center p-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
</div>
<!-- File: Views/ManageOrder/Index.cshtml (Thêm vào cuối) -->
<!-- Confirmation Modal for Cancelling Order -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelOrderModalLabel">Xác nhận Hủy Đơn Hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn hủy đơn hàng <strong id="order-id-to-cancel"></strong>? Hành động này không thể hoàn tác.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Không</button>
                <button type="button" class="btn btn-danger" id="confirm-cancel-btn">Có, Hủy đơn hàng</button>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        $(document).ready(function () {
    // --- CÁC HÀM HELPER ---

    // Hàm để tải danh sách đơn hàng
    function loadOrders(statusId) {
        $('#order-list-container').html('<div class="text-center p-5"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>');
        $('#order-list-container').load('@Url.Action("GetOrdersByStatus", "ManageOrder")?statusId=' + statusId);
    }

    // HÀM MỚI: Cập nhật số lượng trên các badge
    function updateBadgeCounts() {
        $.get('@Url.Action("GetOrderCounts", "ManageOrder")', function (response) {
            if (response.success) {
                const counts = response.data;
                // Tìm từng nút tab và cập nhật badge bên trong nó
                $('#order-status-tabs .nav-link[data-status-id=""]').find('.badge').text(counts.all);
                $('#order-status-tabs .nav-link[data-status-id="0"]').find('.badge').text(counts.waiting);
                $('#order-status-tabs .nav-link[data-status-id="1"]').find('.badge').text(counts.processing);
                $('#order-status-tabs .nav-link[data-status-id="2"]').find('.badge').text(counts.shipping);
                $('#order-status-tabs .nav-link[data-status-id="3"]').find('.badge').text(counts.completed);
                $('#order-status-tabs .nav-link[data-status-id="4"]').find('.badge').text(counts.cancelled);
            }
        });
    }

    // --- GẮN SỰ KIỆN ---

    // Bắt sự kiện click trên các nút tab
    $('#order-status-tabs .nav-link').on('click', function () {
        $('#order-status-tabs .nav-link').removeClass('active');
        $(this).addClass('active');
        var statusId = $(this).data('status-id');
        loadOrders(statusId);
    });

    // Tải danh sách "Tất cả" khi trang được mở lần đầu
    loadOrders('');

    // --- LOGIC HỦY ĐƠN HÀNG ---
    var cancelOrderModal = new bootstrap.Modal(document.getElementById('cancelOrderModal'));
    var orderIdToCancel = 0;

    $(document).on('click', '.btn-open-cancel-modal', function () {
        orderIdToCancel = $(this).data('order-id');
        $('#order-id-to-cancel').text('#' + orderIdToCancel);
        cancelOrderModal.show();
    });

    $('#confirm-cancel-btn').on('click', function () {
        var btn = $(this);
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Đang xử lý...');

        $.ajax({
            url: '@Url.Action("CancelOrder", "ManageOrder")',
            type: 'POST',
            data: {
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                id: orderIdToCancel
            },
            success: function (response) {
                if (response.success) {
                    cancelOrderModal.hide();
                    showAlert(response.message, 'success');

                    // Cập nhật giao diện tức thì (giữ nguyên)
                    var canceledOrderCard = $('.btn-open-cancel-modal[data-order-id="' + orderIdToCancel + '"]').closest('.card');
                    if (canceledOrderCard.length > 0) {
                        canceledOrderCard.find('.btn-open-cancel-modal').remove();
                        canceledOrderCard.find('.card-header span').text('Đã hủy').removeClass('text-primary').addClass('text-danger');
                    }

                    // GỌI HÀM CẬP NHẬT BADGE
                    updateBadgeCounts();

                    // Tải lại danh sách sau một khoảng trễ
                    setTimeout(function () {
                        var activeTab = $('#order-status-tabs .nav-link.active');
                        loadOrders(activeTab.data('status-id'));
                    }, 500);

                } else {
                    showAlert(response.message, 'danger');
                }
            },
            error: function () {
                showAlert('Đã xảy ra lỗi. Vui lòng thử lại.', 'danger');
            },
            complete: function () {
                btn.prop('disabled', false).text('Có, Hủy đơn hàng');
            }
        });
    });
});
    </script>
}