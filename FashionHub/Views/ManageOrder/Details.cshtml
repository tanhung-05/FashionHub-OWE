@model FashionHub.Models.DonHang
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.IDDonHang;
}

<div class="container my-5">
    <h2 class="mb-4">Chi tiết đơn hàng #@Model.IDDonHang</h2>

    <div class="row">
        <div class="col-md-8">
            <!-- ... (Copy code từ trang chi tiết đơn hàng của Admin) ... -->
            <div class="card mb-3">
                <div class="card-header">Danh sách sản phẩm</div>
                <div class="card-body">
                    <table class="table">
                        <tbody>
                            @foreach (var detail in Model.ChiTietDonHangs)
                            {
                                <tr>
                                    <td>
                                        <strong>@detail.TenSanPham</strong><br>
                                        <small class="text-muted">Màu: @detail.TenMau, Size: @detail.TenKichThuoc</small>
                                    </td>
                                    <td class="text-end">@detail.DonGia.ToString("N0") VNĐ</td>
                                    <td class="text-center">x @detail.SoLuong</td>
                                    <td class="text-end fw-bold">@((detail.DonGia * detail.SoLuong).ToString("N0")) VNĐ</td>
                                    @if (Model.IDTrangThai == 3) // Chỉ hiển thị khi đơn hàng 'Hoàn thành'
                                    {
                                        <td><a href="#" class="btn btn-sm btn-outline-primary">Viết đánh giá</a></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <!-- ... (Copy code từ trang chi tiết đơn hàng của Admin) ... -->
            <div class="card">
                <div class="card-header">Thông tin giao hàng</div>
                <div class="card-body">
                    <p><strong>Người nhận:</strong> @Model.TenNguoiNhan</p>
                    <p><strong>Số điện thoại:</strong> @Model.SoDienThoai</p>
                    <p><strong>Địa chỉ:</strong> @Model.DiaChiGiao</p>
                    <hr />
                    <p><strong>Trạng thái:</strong> <span class="fw-bold">@Model.TrangThaiDonHang.TenTrangThai</span></p>
                    <p><strong>Thanh toán:</strong> @Model.PhuongThucThanhToan.TenPhuongThuc</p>
                </div>
            </div>
        </div>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary mt-3">Quay lại Lịch sử đơn hàng</a>
</div>