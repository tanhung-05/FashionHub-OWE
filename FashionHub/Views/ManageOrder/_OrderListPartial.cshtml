
@model List<FashionHub.Models.DonHang>

@if (Model.Any())
{
    foreach (var order in Model)
    {
        var firstDetail = order.ChiTietDonHangs.FirstOrDefault();
        var imageUrl = "/Content/images/placeholder.png"; // Ảnh mặc định
        if (firstDetail != null && firstDetail.BienTheSanPham != null)
        {
            var image = firstDetail.BienTheSanPham.HinhAnh_BienThe.FirstOrDefault(h => h.LaAnhChinh == true)?.HinhAnh;
            if (image != null)
            {
                imageUrl = image.DuongDan;
            }
        }

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <strong>Đơn hàng: #@order.IDDonHang</strong>
                <span class="text-primary fw-bold">@order.TrangThaiDonHang.TenTrangThai</span>
            </div>
            <div class="card-body">
                <div class="d-flex">
                    <img src="@imageUrl" width="80" height="80" class="me-3 rounded" />
                    <div class="flex-grow-1">
                        @if (firstDetail != null)
                        {
                            <p class="mb-1">@firstDetail.TenSanPham</p>
                        }
                        @if (order.ChiTietDonHangs.Count > 1)
                        {
                            <small class="text-muted">và @(order.ChiTietDonHangs.Count - 1) sản phẩm khác...</small>
                        }
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <div>
                    <!-- NÚT HỦY ĐƠN (HIỂN THỊ CÓ ĐIỀU KIỆN) -->
                    @if (order.IDTrangThai == 0) // Chỉ hiển thị khi "Chờ xác nhận"
                    {
                        <button class="btn btn-sm btn-outline-danger me-2 btn-open-cancel-modal"
                                data-order-id="@order.IDDonHang">
                            Hủy đơn
                        </button>
                    }
                    <a href="@Url.Action("Details", new { id = order.IDDonHang })" class="btn btn-primary">Xem chi tiết</a>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="text-center p-5">
        <p>Bạn không có đơn hàng nào ở trạng thái này.</p>
    </div>
}