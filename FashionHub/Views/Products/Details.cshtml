@model FashionHub.ViewModels.ProductDetailViewModel
@{
    ViewBag.Title = Model.TenSanPham;
}
@section styles {
    <style>
        /* Style chung cho nút */
        .variant-btn {
            min-width: 50px;
            padding: 6px 15px;
            border: 1px solid #dee2e6;
            background-color: white;
            color: #212529;
            transition: all 0.2s;
            margin-right: 5px;
            margin-bottom: 5px;
            border-radius: 4px;
        }

            /* Hover */
            .variant-btn:hover:not(:disabled) {
                border-color: #000;
            }

            /* Đang chọn (Active) */
            .variant-btn.active {
                background-color: #000;
                color: white;
                border-color: #000;
            }

            .variant-btn:disabled {
                opacity: 0.5;
                cursor: not-allowed;
                background-color: #f8f9fa;
                border-color: #e9ecef;
                color: #adb5bd;
            }
    </style>
}
<!-- Breadcrumb -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Products", new { categoryId = Model.IDDanhMuc })">@Model.TenDanhMuc</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.TenSanPham</li>
    </ol>
</nav>

<div class="row">
    <!-- Cột hình ảnh -->
    <div class="col-md-6">
        <div class="mb-3 position-relative" >
            @if (Model.IsOutStock)
            {
                <div class="position-absolute top-50 start-50 translate-middle bg-dark text-white px-4 py-2 text-uppercase fw-bold shadow"
                     style="z-index: 10; opacity: 0.3; letter-spacing: 2px; border: 1px solid white;">
                    HẾT HÀNG
                </div>
            }
            <img id="main-product-image" src="@(Model.AllImages.FirstOrDefault()?.DuongDan ?? "/Content/images/placeholder.png")" class="img-fluid rounded" alt="Product Image">
        </div>
        <div class="d-flex overflow-auto">
            @foreach (var image in Model.AllImages)
            {
                <div class="me-2">
                    <img src="@image.DuongDan" class="img-thumbnail" style="width: 80px; height: 80px; cursor: pointer; object-fit: cover;"
                         onclick="document.getElementById('main-product-image').src = this.src;"
                         data-image-id="@image.IDHinhAnh">
                </div>
            }
        </div>
    </div>

    <!-- Cột thông tin sản phẩm -->
    <div class="col-md-6">
        <h2 id="product-name" class="fw-bold">@Model.TenSanPham</h2>
        <p class="text-muted">Thương hiệu: <span class="fw-semibold text-dark">@Model.TenThuongHieu</span></p>

        <!-- HIỂN THỊ GIÁ -->
        <div class="my-3">
            @if (Model.IsSaleActive)
            {
                <div class="d-flex align-items-center">
                    <!-- Giá khuyến mãi -->
                    <h3 class="text-danger fw-bold mb-0 me-3">
                        @Model.GiaKhuyenMai.Value.ToString("N0")₫
                    </h3>
                    <!-- Giá gốc -->
                    <span class="text-muted text-decoration-line-through fs-5">
                        @Model.Gia.ToString("N0")₫
                    </span>
                    <!-- Badge -->
                    <span class="badge bg-danger ms-3">
                        Giảm @Math.Round((1 - (Model.GiaKhuyenMai.Value / Model.Gia)) * 100)%
                    </span>
                </div>
                <!-- Hiển thị hạn sử dụng (Optional) -->
                <div class="text-danger small mt-1">
                    <i class="bi bi-clock"></i> Kết thúc: @Model.NgayKetThucKM.Value.ToString("dd/MM/yyyy")
                </div>
            }
            else
            {
                <h3 class="text-danger fw-bold">
                    @Model.Gia.ToString("N0")₫
                </h3>
            }
        </div>
        <!-- Chọn màu sắc -->
        <div class="mb-3">
            <h6 class="fw-bold">Màu sắc: <span id="selected-color-name" class="fw-normal text-muted"></span></h6>
            <div id="color-selector" class="d-flex flex-wrap gap-2">
                @foreach (var color in Model.AvailableColors)
                {
                    <button class="btn variant-btn color-option" data-color-id="@color.IDMauSac">@color.TenMau</button>
                }
            </div>
        </div>

        <!-- Chọn kích thước -->
        <div class="mb-3">
            <h6 class="fw-bold">Kích thước: <span id="selected-size-name" class="fw-normal text-muted"></span></h6>
            <div id="size-selector" class="d-flex flex-wrap gap-2">
                @foreach (var size in Model.AvailableSizes)
                {
                    <button class="btn variant-btn size-option" data-size-id="@size.IDKichThuoc">@size.TenKichThuoc</button>
                }
            </div>
        </div>

        <!-- Số lượng & Tồn kho -->
        <div class="mb-4">
            <label for="quantity" class="form-label fw-bold">Số lượng:</label>
            <div class="d-flex align-items-center">
                <div class="input-group" style="max-width: 140px;">
                    <button class="btn btn-outline-secondary" type="button" id="btn-minus"><i class="bi bi-dash"></i></button>
                    <input type="text" id="quantity" class="form-control text-center border-secondary" value="1" min="1" readonly>
                    <button class="btn btn-outline-secondary" type="button" id="btn-plus"><i class="bi bi-plus"></i></button>
                </div>
                <span id="stock-info" class="ms-3 text-muted small"></span>
            </div>
        </div>

        <!-- Nút hành động -->
        <div class="d-grid gap-2 d-sm-flex">
            <button id="add-to-cart-btn" class="btn btn-outline-dark flex-grow-1 py-2 text-uppercase fw-bold" data-action-type="add-to-cart" disabled>
                <i class="bi bi-cart-plus me-2"></i> Thêm vào giỏ
            </button>
            <button id="buy-now-btn" class="btn btn-dark flex-grow-1 py-2 text-uppercase fw-bold" data-action-type="buy-now" disabled>
                <i class="bi bi-lightning-fill me-2"></i> Mua ngay
            </button>
        </div>
    </div>
</div>

<!-- Tab mô tả, đánh giá -->
<div class="row mt-5">
    <div class="col-12">
        <ul class="nav nav-tabs" id="productTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold" id="description-tab" data-bs-toggle="tab" data-bs-target="#description" type="button" role="tab">Mô tả sản phẩm</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">Đánh giá</button>
            </li>
        </ul>
        <div class="tab-content p-4 border border-top-0 bg-white rounded-bottom shadow-sm" id="productTabContent">
            <div class="tab-pane fade show active" id="description" role="tabpanel">
                @Html.Raw(Model.MoTa)
            </div>
            <div class="tab-pane fade" id="reviews" role="tabpanel">
                <p class="text-muted fst-italic">Chưa có đánh giá nào cho sản phẩm này.</p>
            </div>
        </div>
    </div>
</div>

<!-- Sản phẩm liên quan -->
@if (Model.RelatedProducts.Any())
{
    <div class="row mt-5 mb-5">
        <div class="col-12">
            <h4 class="mb-4 fw-bold text-uppercase border-bottom pb-2">Sản phẩm liên quan</h4>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
                @foreach (var product in Model.RelatedProducts)
                {
                    <div class="col">
                        @Html.Partial("_ProductCardPartial", product)
                    </div>
                }
            </div>
        </div>
    </div>
}
@section scripts {
    <script>
        $(document).ready(function () {
            // Lấy danh sách TẤT CẢ biến thể (kể cả hết hàng)
            const variants = JSON.parse('@Html.Raw(Model.VariantsJson)');

            let selectedColorId = null;
            let selectedSizeId = null;

            // 1. Hàm kiểm tra tính khả dụng (Logic cốt lõi)
            function checkAvailability() {
                // --- A. XỬ LÝ CÁC NÚT MÀU ---
                $('.color-option').each(function() {
                    const colorId = parseInt($(this).data('color-id'));
                    let isAvailable = false;

                    if (selectedSizeId) {
                        // Nếu ĐÃ chọn Size: Chỉ hiện Màu nào có Size này và còn hàng
                        isAvailable = variants.some(v => v.IDMauSac === colorId && v.IDKichThuoc === selectedSizeId && v.SoLuongTon > 0);
                    } else {
                        // Nếu CHƯA chọn Size: Hiện Màu nào có ít nhất 1 biến thể còn hàng
                        isAvailable = variants.some(v => v.IDMauSac === colorId && v.SoLuongTon > 0);
                    }

                    $(this).prop('disabled', !isAvailable);
                });

                // --- B. XỬ LÝ CÁC NÚT SIZE ---
                $('.size-option').each(function() {
                    const sizeId = parseInt($(this).data('size-id'));
                    let isAvailable = false;

                    if (selectedColorId) {
                        // Nếu ĐÃ chọn Màu: Chỉ hiện Size nào có Màu này và còn hàng
                        isAvailable = variants.some(v => v.IDKichThuoc === sizeId && v.IDMauSac === selectedColorId && v.SoLuongTon > 0);
                    } else {
                        // Nếu CHƯA chọn Màu: Hiện Size nào có ít nhất 1 biến thể còn hàng
                        isAvailable = variants.some(v => v.IDKichThuoc === sizeId && v.SoLuongTon > 0);
                    }

                    $(this).prop('disabled', !isAvailable);
                });
            }

            // 2. Hàm cập nhật thông tin cuối cùng (Giá, Nút mua)
            function updateFinalState() {
                // Tìm biến thể khớp cả 2
                const variant = variants.find(v => v.IDMauSac === selectedColorId && v.IDKichThuoc === selectedSizeId);

                if (variant && variant.SoLuongTon > 0) {
                    // Đã chọn đủ và có hàng
                    $('#stock-info').text(`Còn lại: ${variant.SoLuongTon} sản phẩm`).removeClass('text-danger').addClass('text-muted');
                    $('#quantity').attr('max', variant.SoLuongTon);
                    $('#add-to-cart-btn, #buy-now-btn').prop('disabled', false);
                } else {
                    // Chưa chọn đủ hoặc hết hàng
                    $('#add-to-cart-btn, #buy-now-btn').prop('disabled', true);

                    if (selectedColorId && selectedSizeId) {
                         $('#stock-info').text('Sản phẩm này tạm hết hàng').addClass('text-danger');
                    } else {
                         $('#stock-info').text('');
                    }
                }
            }

            // --- SỰ KIỆN CLICK MÀU ---
            $('.color-option').click(function() {
                const clickedId = parseInt($(this).data('color-id'));

                if (selectedColorId === clickedId) {
                    // Nếu click lại màu đang chọn -> Bỏ chọn (Reset)
                    selectedColorId = null;
                    $(this).removeClass('active');
                    $('#selected-color-name').text('');
                } else {
                    // Chọn màu mới
                    selectedColorId = clickedId;
                    $('.color-option').removeClass('active');
                    $(this).addClass('active');
                    $('#selected-color-name').text($(this).text());

                    // Đổi ảnh theo màu (nếu có)
                    const variantImg = variants.find(v => v.IDMauSac === selectedColorId);
                    if (variantImg && variantImg.HinhAnhIDs.length > 0) {
                        const imgId = variantImg.HinhAnhIDs[0];
                        const src = $(`[data-image-id=${imgId}]`).attr('src');
                        if (src) $('#main-product-image').attr('src', src);
                    }
                }

                // Nếu màu mới chọn không khớp với size đang chọn (do bị disable) -> Bỏ chọn size
                if (selectedSizeId) {
                    const isValidCombination = variants.some(v => v.IDMauSac === selectedColorId && v.IDKichThuoc === selectedSizeId && v.SoLuongTon > 0);
                    if (!isValidCombination && selectedColorId !== null) {
                        selectedSizeId = null;
                        $('.size-option').removeClass('active');
                        $('#selected-size-name').text('');
                    }
                }

                checkAvailability(); // Lọc lại các nút Size
                updateFinalState();
            });

            // --- SỰ KIỆN CLICK SIZE ---
            $('.size-option').click(function() {
                const clickedId = parseInt($(this).data('size-id'));

                if (selectedSizeId === clickedId) {
                    // Bỏ chọn size
                    selectedSizeId = null;
                    $(this).removeClass('active');
                    $('#selected-size-name').text('');
                } else {
                    // Chọn size mới
                    selectedSizeId = clickedId;
                    $('.size-option').removeClass('active');
                    $(this).addClass('active');
                    $('#selected-size-name').text($(this).text());
                }

                // Nếu size mới chọn không khớp với màu đang chọn -> Bỏ chọn màu
                if (selectedColorId) {
                    const isValidCombination = variants.some(v => v.IDMauSac === selectedColorId && v.IDKichThuoc === selectedSizeId && v.SoLuongTon > 0);
                    if (!isValidCombination && selectedSizeId !== null) {
                        selectedColorId = null;
                        $('.color-option').removeClass('active');
                        $('#selected-color-name').text('');
                    }
                }

                checkAvailability(); // Lọc lại các nút Màu
                updateFinalState();
            });

            // --- CÁC SỰ KIỆN KHÁC (Tăng giảm, Mua hàng) ---
            $('#btn-plus').click(function () {
                let qty = parseInt($('#quantity').val());
                let max = parseInt($('#quantity').attr('max')) || 999;
                if (qty < max) $('#quantity').val(qty + 1);
            });

            $('#btn-minus').click(function () {
                let qty = parseInt($('#quantity').val());
                if (qty > 1) $('#quantity').val(qty - 1);
            });

            $('#add-to-cart-btn, #buy-now-btn').click(function () {
                const variant = variants.find(v => v.IDMauSac === selectedColorId && v.IDKichThuoc === selectedSizeId);
                if (!variant) return;

                const quantity = parseInt($('#quantity').val());
                const url = $(this).data('action-type') === 'buy-now' ? '/Cart/BuyNow' : '/Cart/AddToCart';
                const btn = $(this);
                const originalText = btn.html();

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.post(url, { variantId: variant.IDBienThe, quantity: quantity }, function (res) {
                    if (res.success) {
                        if (res.redirectUrl) window.location.href = res.redirectUrl;
                        else {
                            $('#cart-count').text(res.cartCount);
                            alert(res.message);
                        }
                    } else {
                        alert(res.message);
                    }
                }).always(() => btn.prop('disabled', false).html(originalText));
            });

            // KHỞI TẠO LẦN ĐẦU
            checkAvailability(); // Để disable những món hết hàng ngay từ đầu
        });
    </script>
}