@{
    ViewBag.Title = "Đặt hàng thành công";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">

            <!-- Biểu tượng thành công -->
            <div class="success-icon mb-3">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <!-- Tiêu đề và thông điệp -->
            <h1 class="display-5 fw-bold">Đặt hàng thành công!</h1>
            <p class="fs-5 text-muted">Cảm ơn bạn đã mua sắm tại FashionHub.</p>
            <p>
                Mã đơn hàng của bạn là: <strong class="text-primary">#@ViewBag.OrderId</strong>
            </p>
            <p>
                Một email xác nhận đã được gửi đến địa chỉ <strong>@ViewBag.CustomerEmail</strong>.
                Bạn có thể theo dõi trạng thái đơn hàng của mình trong trang "Đơn hàng của tôi".
            </p>

            <hr class="my-4">

            <!-- Các nút hành động -->
            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                <a href="@Url.Action("Index", "ManageOrder")" class="btn btn-primary btn-lg px-4 gap-3">
                    <i class="bi bi-receipt"></i> Xem đơn hàng của tôi
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-house-door"></i> Quay về trang chủ
                </a>
            </div>

        </div>
    </div>
</div>

@section styles {
    <style>
        .success-icon {
            font-size: 6rem; /* Kích thước icon */
            color: #198754; /* Màu xanh lá của Bootstrap success */
        }
    </style>
}