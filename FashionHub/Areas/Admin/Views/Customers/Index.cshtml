@model IEnumerable<FashionHub.Models.NguoiDung>
@{
    ViewBag.Title = "Quản lý Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-uppercase">Danh sách Khách hàng</h4>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light rounded">
        @using (Html.BeginForm("Index", "Customers", FormMethod.Get, new { @class = "row g-2" }))
        {
            <div class="col-md-4">
                <input type="text" name="searchString" class="form-control" placeholder="Tên, Email hoặc SĐT..." value="@Request.QueryString["searchString"]">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Tìm kiếm</button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Họ tên</th>
                    <th>Liên hệ</th>
                    <th>Ngày tham gia</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@item.HoTen</div>
                        </td>
                        <td>
                            <div><i class="bi bi-envelope me-1"></i> @item.Email</div>
                            <div class="small text-muted"><i class="bi bi-telephone me-1"></i> @(item.SoDienThoai ?? "Chưa cập nhật")</div>
                        </td>
                        <td>@item.NgayTao.Value.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.TrangThai == true)
                            {
                                <span class="badge bg-success status-badge" id="status-@item.IDNguoiDung">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger status-badge" id="status-@item.IDNguoiDung">Đã khóa</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("Details", new { id = item.IDNguoiDung })" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            <button class="btn btn-sm btn-outline-warning btn-toggle-status" data-id="@item.IDNguoiDung">
                                <i class="bi bi-lock"></i> Khóa/Mở
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        $('.btn-toggle-status').click(function() {
            var id = $(this).data('id');
            var badge = $('#status-' + id);

            if(confirm('Bạn có chắc muốn thay đổi trạng thái tài khoản này?')) {
                $.post('@Url.Action("ToggleStatus")', { id: id }, function(res) {
                    if(res.success) {
                        if(res.newStatus) {
                            badge.removeClass('bg-danger').addClass('bg-success').text('Hoạt động');
                        } else {
                            badge.removeClass('bg-success').addClass('bg-danger').text('Đã khóa');
                        }
                    } else {
                        alert(res.message);
                    }
                });
            }
        });
    </script>
}