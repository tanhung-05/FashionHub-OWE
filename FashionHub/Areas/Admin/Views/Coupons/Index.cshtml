@model IEnumerable<FashionHub.Models.MaGiamGia>
@{
    ViewBag.Title = "Quản lý Mã giảm giá";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-uppercase">Danh sách Mã giảm giá</h4>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Tạo mã mới
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã Code</th>
                        <th>Tên chương trình</th>
                        <th>Giá trị giảm</th>
                        <th>Điều kiện</th>
                        <th>Lượt dùng</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-ticket-perforated fs-1 d-block mb-2"></i>
                                Chưa có mã giảm giá nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            // Kiểm tra hạn sử dụng để hiển thị màu sắc
                            bool isExpired = item.NgayKetThuc < DateTime.Now;
                            bool isActive = item.TrangThai == true && !isExpired;

                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-dark text-uppercase px-2 py-2" style="letter-spacing: 1px;">@item.MaCode</span>
                                </td>
                                <td>@item.TenChuongTrinh</td>
                                <td class="fw-bold text-danger">
                                    @if (item.LoaiGiamGia == 1)
                                    {
                                        <span>-@item.GiaTri.ToString("N0")đ</span>
                                    }
                                    else
                                    {
                                        <span>-@item.GiaTri.ToString("0")%</span>
                                        if (item.GiamToiDa.HasValue)
                                        {
                                            <div class="small text-muted fw-normal">Tối đa: @item.GiamToiDa.Value.ToString("N0")đ</div>
                                        }
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">Đơn từ: @item.DonHangToiThieu.Value.ToString("N0")đ</small>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 6px; width: 60px;">
                                            @{
                                                var percent = (item.DaSuDung * 100) / (item.SoLuong > 0 ? item.SoLuong : 1);
                                            }
                                            <div class="progress-bar bg-info" role="progressbar" style="width: @percent%"></div>
                                        </div>
                                        <small>@item.DaSuDung / @item.SoLuong</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="small">@item.NgayBatDau.Value.ToString("dd/MM") - @item.NgayKetThuc.Value.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    @if (isActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang chạy</span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã tắt</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-danger btn-delete-coupon" data-id="@item.IDMaGiamGia" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('.btn-delete-coupon').click(function (e) {
                e.preventDefault();
                var btn = $(this);
                var id = btn.data('id');

                if (confirm('Bạn có chắc chắn muốn xóa mã giảm giá này?')) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Coupons")',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                if(res.message) alert(res.message); 
                                btn.closest('tr').fadeOut();
                            } else {
                                alert('Không thể xóa mã này.');
                            }
                        },
                        error: function () {
                            alert('Lỗi kết nối.');
                        }
                    });
                }
            });
        });
    </script>
}