@model FashionHub.Models.DanhMuc
@{
    ViewBag.Title = "Cập nhật danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-pencil-square me-2"></i>Cập nhật: <span class="text-primary">@Model.TenDanhMuc</span>
                </h5>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <!-- QUAN TRỌNG: Phải có dòng này để biết đang sửa danh mục nào -->
                    @Html.HiddenFor(model => model.IDDanhMuc)

                    <!-- Hiển thị lỗi chung (VD: Lỗi chọn cha là chính nó) -->
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger alert-dismissible fade show" })

                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh mục cha</label>
                        <!-- Dropdown này đã được Controller lọc bỏ chính nó để tránh vòng lặp -->
                        @Html.DropDownList("IDDanhMucCha", null, new { @class = "form-select" })
                        <div class="form-text text-muted">
                            <i class="bi bi-info-circle"></i> Thay đổi cấp bậc của danh mục này.
                        </div>
                        @Html.ValidationMessageFor(model => model.IDDanhMucCha, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.TenDanhMuc, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.TenDanhMuc, "", new { @class = "text-danger" })
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>