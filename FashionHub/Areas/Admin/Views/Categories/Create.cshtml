@model FashionHub.Models.DanhMuc
@{
    ViewBag.Title = "Thêm danh mục mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Thêm danh mục mới</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh mục cha</label>
                        <!-- Dropdown này sẽ hiển thị dạng cây -->
                        @Html.DropDownList("IDDanhMucCha", null, new { @class = "form-select" })
                        <div class="form-text">Chọn "Là Danh Mục Gốc" nếu đây là cấp cao nhất.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.TenDanhMuc, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: Áo sơ mi nam" } })
                        @Html.ValidationMessageFor(model => model.TenDanhMuc, "", new { @class = "text-danger" })
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">Lưu danh mục</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>