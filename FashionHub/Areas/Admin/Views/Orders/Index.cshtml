@model IEnumerable<FashionHub.Models.DonHang>
@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-uppercase">Quản lý Đơn hàng</h4>
    <div>
        <!-- Nút Xuất Excel -->
        <a href="@Url.Action("ExportExcel")" class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet"></i> Xuất Excel
        </a>
    </div>
</div>

<!-- BỘ LỌC -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light rounded">
        @using (Html.BeginForm("Index", "Orders", FormMethod.Get, new { @class = "row g-2" }))
        {
            <div class="col-md-3">
                <input type="text" name="searchString" class="form-control" placeholder="Mã đơn / Tên khách..." value="@Request.QueryString["searchString"]">
            </div>
            <div class="col-md-2">
                <select name="statusId" class="form-select">
                    <option value="">-- Trạng thái --</option>
                    @foreach (var st in ViewBag.StatusList as List<FashionHub.Models.TrangThaiDonHang>)
                    {
                        <option value="@st.IDTrangThai" @(Request.QueryString["statusId"] == st.IDTrangThai.ToString() ? "selected" : "")>@st.TenTrangThai</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" class="form-control" value="@Request.QueryString["fromDate"]" title="Từ ngày">
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" class="form-control" value="@Request.QueryString["toDate"]" title="Đến ngày">
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> Lọc đơn hàng</button>
            </div>
        }
    </div>
</div>
<!-- FORM XỬ LÝ HÀNH ĐỘNG HÀNG LOẠT -->
@using (Html.BeginForm("BulkPrint", "Orders", FormMethod.Post, new { id = "bulkForm", target = "_blank" }))
{
    <div class="card shadow-sm">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="selectAll">
                <label class="form-check-label fw-bold" for="selectAll">Chọn tất cả</label>
            </div>
            <button type="submit" class="btn btn-sm btn-secondary">
                <i class="bi bi-printer"></i> In các đơn đã chọn
            </button>
            @if (Model.Any(x => x.IDTrangThai == 0))
            {
                <button class="btn btn-success text-white ms-2" id="btn-confirm-all">
                    <i class="bi bi-check-all"></i> Xác nhận tất cả (@Model.Count(x => x.IDTrangThai == 0))
                </button>
            }
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px;"></th> <!-- Cột Checkbox -->
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <!-- Cột 1: Checkbox -->
                            <td>
                                <input class="form-check-input item-checkbox" type="checkbox" name="selectedIds" value="@item.IDDonHang">
                            </td>

                            <!-- Cột 2: Mã đơn -->
                            <td class="fw-bold">#@item.IDDonHang</td>

                            <!-- Cột 3: Khách hàng -->
                            <td>
                                <div class="fw-bold">@item.TenNguoiNhan</div>
                                <small class="text-muted">@item.SoDienThoai</small>
                            </td>

                            <!-- Cột 4: Ngày đặt (Sửa lỗi null check) -->
                            <td>@(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy") : "N/A")</td>

                            <!-- Cột 5: Tổng tiền -->
                            <td class="fw-bold text-primary">@item.TongThanhToan.ToString("N0") đ</td>

                            <!-- Cột 6: Trạng thái -->
                            <td>
                                @if (item.IDTrangThai == 0)
                                {<span class="badge bg-warning text-dark">Chờ xác nhận</span> }
                                else if (item.IDTrangThai == 1)
                                { <span class="badge bg-info">Đã xác nhận</span> }
                                else if (item.IDTrangThai == 2)
                                { <span class="badge bg-primary">Đang giao</span> }
                                else if (item.IDTrangThai == 3)
                                { <span class="badge bg-success">Hoàn thành</span> }
                                else
                                { <span class="badge bg-danger">Đã hủy</span>}
                            </td>

                            <!-- Cột 7: Hành động (Gộp chung vào 1 cột duy nhất) -->
                            <td class="text-end">
                                <!-- Nút Xác nhận nhanh (Chỉ hiện khi trạng thái là 0) -->
                                @if (item.IDTrangThai == 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success btn-confirm-single me-1"
                                            data-id="@item.IDDonHang"
                                            title="Xác nhận đơn này">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                }

                                <!-- Nút Xem chi tiết -->
                                <a href="@Url.Action("Details", new { id = item.IDDonHang })" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section scripts {
    <script>
        $(document).ready(function ()
        {
        // 1. XỬ LÝ NÚT "XÁC NHẬN" (Từng đơn)
            $('.btn-confirm-single').click(function () {
                var btn = $(this);
                var id = btn.data('id');

                if (confirm('Xác nhận đơn hàng #' + id + '?')) {
                    $.post('@Url.Action("ConfirmOrder", "Orders")', { id: id }, function (res) {
                        if (res.success) {
                            // Reload lại trang để cập nhật trạng thái
                            location.reload();
                        } else {
                            alert(res.message);
                        }
                    });
                }
            });

            // 2. XỬ LÝ NÚT "XÁC NHẬN TẤT CẢ"
            $('#btn-confirm-all').click(function () {
                if (confirm('Bạn có chắc muốn xác nhận TOÀN BỘ đơn hàng đang chờ không?')) {
                    var btn = $(this);
                    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Đang xử lý...');

                    $.post('@Url.Action("ConfirmAllPending", "Orders")', function (res) {
                        if (res.success) {
                            alert(res.message);
                            location.reload();
                        } else {
                            alert(res.message);
                            btn.prop('disabled', false).html('<i class="bi bi-check-all"></i> Xác nhận tất cả');
                        }
                    });
                }
            });
        });




        // Script xử lý chọn tất cả checkbox
        document.getElementById('selectAll').addEventListener('change', function() {
            var checkboxes = document.querySelectorAll('.item-checkbox');
            for (var checkbox of checkboxes) {
                checkbox.checked = this.checked;
            }
        });



    </script>
}