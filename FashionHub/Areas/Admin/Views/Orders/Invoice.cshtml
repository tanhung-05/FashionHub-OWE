@model FashionHub.Models.DonHang
@{
    Layout = null; // Không dùng layout để in cho sạch
}

<!DOCTYPE html>
<html>
<head>
    <title>Hóa đơn #@Model.IDDonHang</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Times New Roman', serif; padding: 40px; color: #000; }
        .invoice-header { border-bottom: 2px solid #000; padding-bottom: 20px; margin-bottom: 20px; }
        .invoice-title { font-size: 24px; font-weight: bold; text-transform: uppercase; }
        .table th { border-top: 2px solid #000 !important; border-bottom: 2px solid #000 !important; }
        .table td { border-bottom: 1px solid #ddd; }
        .total-row td { border-top: 2px solid #000 !important; font-weight: bold; }

        /* Ẩn nút in khi in ra giấy */
        @@media print {
            .no-print { display: none; }
            body { padding: 0; }
        }
    </style>
</head>
<body>
    <!-- Nút in (Chỉ hiện trên màn hình) -->
    <div class="text-end mb-4 no-print">
        <button onclick="window.print()" class="btn btn-primary">In Hóa Đơn</button>
        <button onclick="window.close()" class="btn btn-secondary">Đóng</button>
    </div>

    <div class="container">
        <!-- Header -->
        <div class="row invoice-header">
            <div class="col-6">
                <h2 class="fw-bold">FASHION HUB</h2>
                <p class="mb-0">Địa chỉ: 144 Xuân Thủy, Cầu Giấy, Hà Nội</p>
                <p class="mb-0">Hotline: 1900 1000</p>
                <p>Website: www.fashionhub.com</p>
            </div>
            <div class="col-6 text-end">
                <div class="invoice-title">HÓA ĐƠN BÁN HÀNG</div>
                <p class="mb-0">Số: <strong>#@Model.IDDonHang</strong></p>
                <p>Ngày: @Model.NgayTao.Value.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>

        <!-- Thông tin khách -->
        <div class="row mb-4">
            <div class="col-12">
                <p><strong>Khách hàng:</strong> @Model.TenNguoiNhan</p>
                <p><strong>Điện thoại:</strong> @Model.SoDienThoai</p>
                <p><strong>Địa chỉ giao:</strong> @Model.DiaChiGiao</p>
            </div>
        </div>

        <!-- Bảng sản phẩm -->
        <table class="table mb-4">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên sản phẩm</th>
                    <th class="text-center">ĐVT</th>
                    <th class="text-center">SL</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in Model.ChiTietDonHangs)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>
                            @item.TenSanPham
                            <br /><small><i>(@item.TenMau / @item.TenKichThuoc)</i></small>
                        </td>
                        <td class="text-center">Cái</td>
                        <td class="text-center">@item.SoLuong</td>
                        <td class="text-end">@item.DonGia.ToString("N0")</td>
                        <td class="text-end">@((item.DonGia * item.SoLuong).ToString("N0"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" class="text-end">Tổng tiền hàng:</td>
                    <td class="text-end">@Model.TongTienHang.ToString("N0")</td>
                </tr>
                <tr>
                    <td colspan="5" class="text-end">Phí vận chuyển:</td>
                    <td class="text-end">@((Model.PhiVanChuyen ?? 0).ToString("N0"))</td>
                </tr>
                @if (Model.TienGiamGia > 0)
                {
                    <tr>
                        <td colspan="5" class="text-end">Giảm giá:</td>
                        <td class="text-end">-@((Model.TienGiamGia ?? 0).ToString("N0"))</td>
                    </tr>
                }
                <tr class="total-row">
                    <td colspan="5" class="text-end fs-5">TỔNG THANH TOÁN:</td>
                    <td class="text-end fs-5">@Model.TongThanhToan.ToString("N0") đ</td>
                </tr>
            </tfoot>
        </table>

        <!-- Footer -->
        <div class="row mt-5 text-center">
            <div class="col-6">
                <p><strong>Người mua hàng</strong></p>
                <p class="small">(Ký, ghi rõ họ tên)</p>
            </div>
            <div class="col-6">
                <p><strong>Người bán hàng</strong></p>
                <p class="small">(Ký, ghi rõ họ tên)</p>
            </div>
        </div>

        <div class="text-center mt-5 fst-italic small">
            Cảm ơn quý khách đã mua sắm tại FashionHub!
        </div>
    </div>

    <script>
        // Tự động mở hộp thoại in khi trang load xong
        window.onload = function() {
            // window.print();
        }
    </script>
</body>
</html>