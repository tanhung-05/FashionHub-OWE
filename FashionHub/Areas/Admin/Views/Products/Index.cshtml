@model IEnumerable<FashionHub.Models.SanPham>
@{
    ViewBag.Title = "Quản lý Sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-uppercase">Danh sách Sản phẩm</h4>
    <div>
        <a href="@Url.Action("Export")" class="btn btn-success me-2">
            <i class="bi bi-file-earmark-spreadsheet"></i> Xuất Excel
        </a>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm mới
        </a>
    </div>
</div>

<!-- THANH CÔNG CỤ TÌM KIẾM & LỌC -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light rounded">
        @using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
        {
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" class="form-control" placeholder="Tên sản phẩm..." value="@Request.QueryString["searchString"]">
                </div>
            </div>
            <div class="col-md-2">
                @Html.DropDownList("categoryId", (IEnumerable<SelectListItem>)ViewBag.DanhMucs, "-- Danh mục --", new { @class = "form-select" })
            </div>
            <div class="col-md-2">
                <select name="brandId" class="form-select">
                    <option value="">-- Thương hiệu --</option>
                    @foreach (var item in ViewBag.ThuongHieux as List<FashionHub.Models.ThuongHieu>)
                    {
                        <option value="@item.IDThuongHieu" @(Request.QueryString["brandId"] == item.IDThuongHieu.ToString() ? "selected" : "")>@item.TenThuongHieu</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">-- Trạng thái --</option>
                    <option value="1" @(Request.QueryString["status"] == "1" ? "selected" : "")>Đang bán</option>
                    <option value="0" @(Request.QueryString["status"] == "0" ? "selected" : "")>Ngừng bán</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-dark w-100"><i class="bi bi-funnel"></i> Lọc dữ liệu</button>
            </div>
        }
    </div>
</div>

<!-- BẢNG DỮ LIỆU -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Phân loại</th>
                        <th>Thống kê</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy sản phẩm nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var firstImage = item.BienTheSanPhams
                                .SelectMany(bt => bt.HinhAnh_BienThe)
                                .OrderByDescending(h => h.LaAnhChinh)
                                .FirstOrDefault()?.HinhAnh.DuongDan;

                            var variantCount = item.BienTheSanPhams.Count;
                            var totalStock = item.BienTheSanPhams.Sum(bt => bt.SoLuongTon);
                            var price = item.Gia;

                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@item.IDSanPham</td>
                                <td>
                                    <div class="position-relative" style="width: 60px; height: 60px;">
                                        @if (firstImage != null)
                                        {
                                            <img src="@firstImage" class="rounded border w-100 h-100" style="object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded border w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            @variantCount
                                            <span class="visually-hidden">biến thể</span>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.IDSanPham })" class="text-decoration-none fw-bold text-dark">
                                        @item.TenSanPham
                                    </a>
                                    <div class="small text-danger fw-bold mt-1">
                                        @price.ToString("N0") đ
                                    </div>
                                    <!-- Hiển thị giá khuyến mãi nếu có -->
                                    @if (item.GiaKhuyenMai.HasValue)
                                    {
                                        <div class="small text-muted text-decoration-line-through">
                                            Sale: @item.GiaKhuyenMai.Value.ToString("N0") đ
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="small"><span class="text-muted">DM:</span> @item.DanhMuc.TenDanhMuc</div>
                                    <div class="small"><span class="text-muted">TH:</span> @item.ThuongHieu.TenThuongHieu</div>
                                </td>
                                <td>
                                    @if (totalStock > 0)
                                    {
                                        <span class="badge bg-light text-dark border">Kho: @totalStock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Hết hàng</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TrangThai == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Ngừng bán</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Edit", new { id = item.IDSanPham })" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button class="btn btn-sm btn-warning text-dark btn-discount"
                                            data-id="@item.IDSanPham"
                                            data-price="@item.Gia"
                                            data-km-price="@(item.GiaKhuyenMai ?? 0)"
                                            data-start="@(item.NgayBatDauKM.HasValue ? item.NgayBatDauKM.Value.ToString("yyyy-MM-dd") : "")"
                                            data-end="@(item.NgayKetThucKM.HasValue ? item.NgayKetThucKM.Value.ToString("yyyy-MM-dd") : "")"
                                            title="Tạo chương trình khuyến mãi">
                                        <i class="bi bi-percent"></i> KM
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger btn-delete-product" data-id="@item.IDSanPham" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL KHUYẾN MÃI (Đặt ở đây cho gọn) -->
<div class="modal fade" id="discountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title fw-bold">Thiết lập Khuyến mãi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="discount-product-id">
                <input type="hidden" id="discount-original-price-hidden"> <!-- Giá gốc dạng số -->

                <div class="mb-3">
                    <label class="form-label">Giá gốc:</label>
                    <input type="text" id="discount-original-price-display" class="form-control fw-bold" disabled>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Giảm giá (%):</label>
                        <div class="input-group">
                            <input type="number" id="discount-percent" class="form-control" min="0" max="100" placeholder="0">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Giá sau giảm:</label>
                        <input type="text" id="discount-final-price" class="form-control text-danger fw-bold" disabled value="0">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Ngày bắt đầu:</label>
                        <input type="date" id="discount-start" class="form-control">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Ngày kết thúc:</label>
                        <input type="date" id="discount-end" class="form-control">
                    </div>
                </div>

                <div class="form-text text-muted text-center">
                    Nhập 0% để hủy chương trình khuyến mãi cho sản phẩm này.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-dark" id="btn-save-discount">Lưu chương trình</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // --- 1. XỬ LÝ MODAL KHUYẾN MÃI ---
            var discountModal = new bootstrap.Modal(document.getElementById('discountModal'));

            // 1. Mở Modal và điền dữ liệu cũ
            $('.btn-discount').click(function () {
                var id = $(this).data('id');
                var price = parseFloat($(this).data('price'));
                var kmPrice = parseFloat($(this).data('km-price'));
                var start = $(this).data('start');
                var end = $(this).data('end');

                $('#discount-product-id').val(id);
                $('#discount-original-price-hidden').val(price);
                $('#discount-original-price-display').val(price.toLocaleString('vi-VN') + ' đ');

                // Tính ngược lại % nếu đang có KM
                if (kmPrice > 0 && kmPrice < price) {
                    var percent = Math.round(((price - kmPrice) / price) * 100);
                    $('#discount-percent').val(percent);
                    $('#discount-final-price').val(kmPrice.toLocaleString('vi-VN') + ' đ');
                } else {
                    $('#discount-percent').val('');
                    $('#discount-final-price').val(price.toLocaleString('vi-VN') + ' đ');
                }

                // Điền ngày tháng (nếu chưa có thì lấy ngày hiện tại)
                var today = new Date().toISOString().split('T')[0];
                $('#discount-start').val(start || today);
                $('#discount-end').val(end || "");

                discountModal.show();
            });

            // 2. Tự động tính tiền khi nhập %
            $('#discount-percent').on('input', function() {
                var percent = parseFloat($(this).val());
                var original = parseFloat($('#discount-original-price-hidden').val());

                if (isNaN(percent) || percent < 0) percent = 0;
                if (percent > 100) percent = 100;

                var finalPrice = original * (100 - percent) / 100;
                $('#discount-final-price').val(finalPrice.toLocaleString('vi-VN') + ' đ');
            });

            // 3. Lưu
            $('#btn-save-discount').click(function () {
                var id = $('#discount-product-id').val();
                var percent = $('#discount-percent').val();
                var start = $('#discount-start').val();
                var end = $('#discount-end').val();

                if(!percent) percent = 0;

                $.post('@Url.Action("ApplyDiscount", "Products")', {
                    id: id,
                    discountPercent: percent,
                    startDate: start,
                    endDate: end
                }, function (res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                });
            });

            // --- 2. XỬ LÝ XÓA SẢN PHẨM ---
            $('.btn-delete-product').click(function (e) {
                e.preventDefault();
                var btn = $(this);
                var id = btn.data('id');

                if (confirm('Bạn có chắc chắn muốn xóa sản phẩm này? Hành động này không thể hoàn tác!')) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Products")',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                btn.closest('tr').fadeOut();
                            } else {
                                alert(res.message);
                            }
                        },
                        error: function () {
                            alert('Lỗi kết nối đến máy chủ.');
                        }
                    });
                }
            });
        });
    </script>
}