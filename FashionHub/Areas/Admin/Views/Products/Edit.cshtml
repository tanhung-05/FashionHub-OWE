@using System.Linq
@using System.Web.Mvc.Html
@model FashionHub.Areas.Admin.ViewModels.ProductViewModel
@{
    ViewBag.Title = "Quản lý sản phẩm: " + Model.TenSanPham;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var variants = ViewBag.ExistingVariants as List<FashionHub.Models.BienTheSanPham>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewBag.Title</h2>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại danh sách</a>
</div>

<!-- PHẦN 1: THÔNG TIN CHUNG -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">Thông tin chung</div>
    <div class="card-body">
        @using (Html.BeginForm("Edit", "Products", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IDSanPham)

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.TenSanPham, "Tên sản phẩm")
                    @Html.TextBoxFor(m => m.TenSanPham, new { @class = "form-control" })
                </div>
                <div class="col-md-3 mb-3">
                    @Html.LabelFor(m => m.IDDanhMuc, "Danh mục")
                    <!-- Dropdown này giờ sẽ hiển thị dạng Group (Cha không chọn được) -->
                    @Html.DropDownList("IDDanhMuc", (List<SelectListItem>)ViewBag.IDDanhMuc, new { @class = "form-select" })
                </div>
                <div class="col-md-3 mb-3">
                    @Html.LabelFor(m => m.IDThuongHieu, "Thương hiệu")
                    @Html.DropDownList("IDThuongHieu", null, new { @class = "form-select" })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Gia, "Giá bán (VNĐ)", new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.Gia, new
                {
                    @class = "form-control",
                    type = "number",
                    min = "0",
                    @Value = Model.Gia.ToString("0.##")
                })
                @Html.ValidationMessageFor(m => m.Gia, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.MoTa, "Mô tả")
                @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "4" })
            </div>
            <button type="submit" class="btn btn-success">Lưu thông tin chung</button>
        }
    </div>
</div>

<!-- PHẦN 2: QUẢN LÝ BIẾN THỂ -->
<div class="card">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <span>Danh sách biến thể (Màu sắc - Kích thước)</span>
        <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addVariantModal">
            <i class="bi bi-plus-circle"></i> Thêm biến thể mới
        </button>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>SKU</th>
                    <th>Màu sắc</th>
                    <th>Kích thước</th>
                    <th style="width: 250px;">Quản lý Tồn kho</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (variants != null && variants.Any())
                {
                    foreach (var v in variants)
                    {
                        var imgObj = v.HinhAnh_BienThe.FirstOrDefault(h => h.LaAnhChinh == true);
                        var img = imgObj != null ? imgObj.HinhAnh.DuongDan : null;
                        <tr>
                            <td>
                                @if (img != null)
                                {<img src="@img" width="50" class="rounded border" /> }
                                else
                                { <span class="text-muted small">No Image</span>}
                            </td>
                            <td>@v.SKU</td>
                            <td>@v.MauSac.TenMau</td>
                            <td>@v.KichThuoc.TenKichThuoc</td>

                            <!-- CỘT NHẬP KHO MỚI -->
                            <td>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span>Hiện có:</span>
                                    <span class="fw-bold fs-5" id="stock-display-@v.IDBienThe">@v.SoLuongTon</span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="number" class="form-control" id="import-qty-@v.IDBienThe" placeholder="Nhập thêm..." min="1">
                                    <button class="btn btn-success btn-import-stock" data-id="@v.IDBienThe">
                                        <i class="bi bi-download"></i> Nhập
                                    </button>
                                </div>
                            </td>

                            <td>
                                <button class="btn btn-sm btn-info text-white btn-manage-images me-1" data-id="@v.IDBienThe" title="Quản lý ảnh">
                                    <i class="bi bi-images"></i>
                                </button>
                                <button class="btn btn-sm btn-danger btn-delete-variant" data-id="@v.IDBienThe" title="Xóa biến thể">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center py-3">Chưa có biến thể nào. Hãy thêm mới!</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL THÊM BIẾN THỂ (GIỮ NGUYÊN) -->
<div class="modal fade" id="addVariantModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm biến thể mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="add-variant-form" enctype="multipart/form-data">
                    <input type="hidden" name="IDSanPham" value="@Model.IDSanPham" />
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label>Màu sắc</label>
                            @Html.DropDownList("IDMauSac", (SelectList)ViewBag.Colors, new { @class = "form-select", name = "IDMauSac" })
                        </div>
                        <div class="col-6 mb-3">
                            <label>Kích thước</label>
                            @Html.DropDownList("IDKichThuoc", (SelectList)ViewBag.Sizes, new { @class = "form-select", name = "IDKichThuoc" })
                        </div>
                    </div>
                    <div class="mb-3">
                        <label>Số lượng tồn ban đầu</label>
                        <input type="number" name="SoLuongTon" class="form-control" required min="0" />
                    </div>
                    <div class="mb-3">
                        <label>Hình ảnh đại diện</label>
                        <input type="file" name="UploadImage" class="form-control" accept="image/*" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btn-save-variant">Lưu biến thể</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL QUẢN LÝ ẢNH (GIỮ NGUYÊN) -->
<div class="modal fade" id="manageImagesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Quản lý hình ảnh biến thể</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="file" class="form-control" id="new-variant-image" accept="image/*">
                    <button class="btn btn-primary" type="button" id="btn-upload-image">
                        <i class="bi bi-cloud-upload"></i> Upload
                    </button>
                </div>
                <hr />
                <div id="image-gallery" class="row g-3"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // --- 1. XỬ LÝ NHẬP KHO (MỚI) ---
            $('.btn-import-stock').click(function() {
                var btn = $(this);
                var id = btn.data('id');
                var input = $('#import-qty-' + id);
                var qtyToAdd = parseInt(input.val());

                if (isNaN(qtyToAdd) || qtyToAdd <= 0) {
                    alert("Vui lòng nhập số lượng lớn hơn 0");
                    return;
                }

                // Hiệu ứng loading
                var originalHtml = btn.html();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.post('@Url.Action("ImportStock", "Products")', { variantId: id, quantityToAdd: qtyToAdd }, function(res) {
                    if (res.success) {
                        // Cập nhật số lượng hiển thị
                        $('#stock-display-' + id).text(res.newStock);
                        // Reset ô input
                        input.val('');
                        // Thông báo nhỏ (Optional)
                        // alert(res.message);
                    } else {
                        alert(res.message);
                    }
                }).always(function() {
                    btn.prop('disabled', false).html(originalHtml);
                });
            });

            // --- 2. CÁC SCRIPT CŨ (Thêm biến thể, Xóa, Ảnh...) ---
            // (Giữ nguyên logic cũ của bạn ở đây)

            $('#btn-save-variant').click(function () {
                var formData = new FormData($('#add-variant-form')[0]);
                $.ajax({
                    url: '@Url.Action("AddVariant", "Products")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) { location.reload(); }
                        else { alert(res.message); }
                    }
                });
            });

            $('.btn-delete-variant').click(function () {
                if (confirm('Bạn có chắc muốn xóa biến thể này?')) {
                    var id = $(this).data('id');
                    $.post('@Url.Action("DeleteVariant", "Products")', { id: id }, function (res) {
                        if (res.success) { location.reload(); }
                        else { alert(res.message); }
                    });
                }
            });

            // Logic quản lý ảnh (Copy lại từ code cũ của bạn)
            var currentVariantId = 0;
            var manageImagesModal = new bootstrap.Modal(document.getElementById('manageImagesModal'));

            $('.btn-manage-images').click(function (e) {
                e.preventDefault();
                currentVariantId = $(this).data('id');
                loadImages(currentVariantId);
                manageImagesModal.show();
            });

            function loadImages(variantId) {
                $('#image-gallery').html('<div class="text-center"><div class="spinner-border"></div></div>');
                $.get('@Url.Action("GetVariantImages", "Products")', { variantId: variantId }, function (res) {
                    if (res.success) {
                        var html = '';
                        if (res.data.length === 0) {
                            html = '<p class="text-center text-muted">Chưa có hình ảnh nào.</p>';
                        } else {
                            $.each(res.data, function (i, img) {
                                var btnClass = img.LaAnhChinh ? 'btn-warning' : 'btn-outline-secondary';
                                var btnText = img.LaAnhChinh ? '<i class="bi bi-star-fill"></i> Chính' : '<i class="bi bi-star"></i> Đặt chính';
                                var borderClass = img.LaAnhChinh ? 'border-warning border-3' : 'border';
                                html += `
                                    <div class="col-md-3 col-6 text-center">
                                        <div class="card h-100 ${borderClass}">
                                            <img src="${img.DuongDan}" class="card-img-top" style="height: 120px; object-fit: cover;">
                                            <div class="card-body p-2">
                                                <button class="btn btn-sm ${btnClass} w-100 mb-1 btn-set-main" data-img-id="${img.IDHinhAnh}">${btnText}</button>
                                                <button class="btn btn-sm btn-outline-danger w-100 btn-delete-img" data-img-id="${img.IDHinhAnh}"><i class="bi bi-trash"></i> Xóa</button>
                                            </div>
                                        </div>
                                    </div>`;
                            });
                        }
                        $('#image-gallery').html(html);
                    }
                });
            }

            $('#btn-upload-image').click(function () {
                var fileInput = $('#new-variant-image')[0];
                if (fileInput.files.length === 0) { alert('Vui lòng chọn file!'); return; }
                var formData = new FormData();
                formData.append('variantId', currentVariantId);
                formData.append('file', fileInput.files[0]);
                $.ajax({
                    url: '@Url.Action("UploadImage", "Products")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) { $('#new-variant-image').val(''); loadImages(currentVariantId); }
                        else { alert(res.message); }
                    }
                });
            });

            $(document).on('click', '.btn-set-main', function () {
                var imgId = $(this).data('img-id');
                $.post('@Url.Action("SetMainImage", "Products")', { variantId: currentVariantId, imageId: imgId }, function (res) {
                    if (res.success) loadImages(currentVariantId); else alert(res.message);
                });
            });

            $(document).on('click', '.btn-delete-img', function () {
                if (confirm('Xóa ảnh này?')) {
                    var imgId = $(this).data('img-id');
                    $.post('@Url.Action("DeleteImage", "Products")', { variantId: currentVariantId, imageId: imgId }, function (res) {
                        if (res.success) loadImages(currentVariantId); else alert(res.message);
                    });
                }
            });
        });
    </script>
}