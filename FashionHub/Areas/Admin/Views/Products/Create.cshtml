@model FashionHub.Areas.Admin.ViewModels.ProductViewModel
@{
    ViewBag.Title = "Thêm sản phẩm mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-uppercase">
                    <i class="bi bi-plus-circle me-2"></i>Thêm sản phẩm mới
                </h5>
            </div>
            <div class="card-body p-4">
                <!-- Bước 1: Thông báo quy trình -->
                <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                    <div>
                        <strong>Quy trình tạo sản phẩm:</strong><br />
                        1. Nhập thông tin chung (Tên, Giá, Danh mục...) tại đây.<br />
                        2. Sau khi lưu, hệ thống sẽ chuyển sang trang quản lý để bạn <strong>thêm Biến thể (Màu/Size)</strong> và <strong>Hình ảnh</strong>.
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <!-- Tên sản phẩm -->
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                            @Html.EditorFor(model => model.TenSanPham, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Ví dụ: Áo Thun Cotton Premium" } })
                            @Html.ValidationMessageFor(model => model.TenSanPham, "", new { @class = "text-danger" })
                        </div>

                        <!-- Danh mục -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                            @Html.DropDownList("IDDanhMuc", null, "-- Chọn Danh mục --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.IDDanhMuc, "", new { @class = "text-danger" })
                        </div>

                        <!-- Thương hiệu -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Thương hiệu <span class="text-danger">*</span></label>
                            @Html.DropDownList("IDThuongHieu", null, "-- Chọn Thương hiệu --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.IDThuongHieu, "", new { @class = "text-danger" })
                        </div>

                        <!-- --- QUAN TRỌNG: THÊM Ô NHẬP GIÁ BÁN --- -->
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            @Html.EditorFor(model => model.Gia, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", placeholder = "Nhập giá bán..." } })
                            @Html.ValidationMessageFor(model => model.Gia, "", new { @class = "text-danger" })
                        </div>
                        <!-- ---------------------------------------- -->
                        <!-- Mô tả -->
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Mô tả sản phẩm</label>
                            @Html.TextAreaFor(model => model.MoTa, new { @class = "form-control", rows = "6", placeholder = "Nhập mô tả chi tiết về chất liệu, kiểu dáng..." })
                            @Html.ValidationMessageFor(model => model.MoTa, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="@Url.Action("Index")" class="btn btn-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-arrow-right me-2"></i>Tiếp tục: Thêm Biến thể
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>