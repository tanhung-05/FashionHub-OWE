@model FashionHub.Areas.Admin.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Tổng quan";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row g-4 mb-4">
    <!-- Card Doanh thu -->
    <div class="col-md-3">
        <div class="card stat-card bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-success me-3">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Doanh thu</h6>
                    <h4 class="mb-0 fw-bold">@Model.TotalRevenue.ToString("N0") ₫</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Đơn hàng mới -->
    <div class="col-md-3">
        <div class="card stat-card bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-warning me-3">
                    <i class="bi bi-cart-plus"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Đơn chờ xử lý</h6>
                    <h4 class="mb-0 fw-bold">@Model.NewOrders</h4>
                    <a href="@Url.Action("Index", "Orders", new { status = 0 })" class="small text-decoration-none stretched-link">Xem ngay</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Tổng sản phẩm -->
    <div class="col-md-3">
        <div class="card stat-card bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-primary me-3">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Sản phẩm</h6>
                    <h4 class="mb-0 fw-bold">@Model.TotalProducts</h4>
                    <a href="@Url.Action("Index", "Products")" class="small text-decoration-none stretched-link">Quản lý</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Khách hàng -->
    <div class="col-md-3">
        <div class="card stat-card bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-info me-3">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Khách hàng</h6>
                    <h4 class="mb-0 fw-bold">@Model.TotalCustomers</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PHẦN 3: BIỂU ĐỒ (THÊM MỚI) -->
<div class="row">
    <!-- Biểu đồ Doanh thu 7 ngày -->
    <div class="col-md-8 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-graph-up-arrow me-2"></i>Xu hướng doanh thu (7 ngày qua)</h6>
            </div>
            <div class="card-body">
                <canvas id="revenueTrendChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Biểu đồ Trạng thái đơn hàng -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-pie-chart me-2"></i>Tỷ lệ đơn hàng</h6>
            </div>
            <div class="card-body">
                <canvas id="orderStatusChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <!-- Nhúng Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function () {
            // 1. VẼ BIỂU ĐỒ DOANH THU 7 NGÀY
            $.get('@Url.Action("GetRevenueTrend")', function (res) {
                var labels = res.map(x => x.Date);
                var data = res.map(x => x.Revenue);

                new Chart(document.getElementById('revenueTrendChart'), {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Doanh thu (VNĐ)',
                            data: data,
                            borderColor: '#0d6efd', // Màu xanh Primary
                            backgroundColor: 'rgba(13, 110, 253, 0.1)',
                            fill: true,
                            tension: 0.3 // Độ cong của đường
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } }, // Ẩn chú thích cho gọn
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            });

            // 2. VẼ BIỂU ĐỒ TRÒN TRẠNG THÁI ĐƠN HÀNG
            $.get('@Url.Action("GetOrderStatusData")', function (res) {
                var labels = res.map(x => x.Label);
                var data = res.map(x => x.Count);
                var colors = res.map(x => x.Color);

                new Chart(document.getElementById('orderStatusChart'), {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: colors,
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            });
        });
    </script>
}