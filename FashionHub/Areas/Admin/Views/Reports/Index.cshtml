@{
    ViewBag.Title = "Báo cáo thống kê";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold text-uppercase">Báo cáo kinh doanh</h4>
    <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
        <i class="bi bi-printer"></i> In báo cáo
    </button>
</div>

<!-- 1. CÁC THẺ THỐNG KÊ TỔNG QUAN -->
<div class="row mb-4">
    <!-- Doanh thu -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-primary text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase opacity-75 small fw-bold">Tổng Doanh Thu</h6>
                        <h3 class="fw-bold mb-0">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) đ</h3>
                        <small class="text-white-50">Hôm nay: @(((decimal)ViewBag.TodayRevenue).ToString("N0")) đ</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-currency-dollar"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Đơn hàng -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-success text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase opacity-75 small fw-bold">Tổng Đơn Hàng</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalOrders</h3>
                        <small class="text-white-50">Đơn hàng toàn hệ thống</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-receipt"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sản phẩm -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-warning text-dark h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase opacity-75 small fw-bold">Sản Phẩm</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalProducts</h3>
                        <small class="opacity-75">Đang kinh doanh</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-box-seam"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Khách hàng -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-info text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase opacity-75 small fw-bold">Khách Hàng</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalCustomers</h3>
                        <small class="text-white-50">Thành viên đăng ký</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-people"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. BIỂU ĐỒ (GIỮ NGUYÊN CODE CŨ CỦA BẠN Ở DƯỚI ĐÂY) -->
<div class="row">
    <!-- BIỂU ĐỒ DOANH THU -->
    <div class="col-md-8 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-graph-up me-2"></i>Biểu đồ doanh thu (30 ngày)</h6>
            </div>
            <div class="card-body">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- BIỂU ĐỒ TOP SẢN PHẨM -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-trophy me-2"></i>Top 5 Bán chạy</h6>
            </div>
            <div class="card-body">
                <canvas id="productChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <!-- Nhúng thư viện Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function () {
            // 1. VẼ BIỂU ĐỒ DOANH THU
            $.get('@Url.Action("GetRevenueData")', function (res) {
                var labels = res.map(x => x.Date);
                var data = res.map(x => x.Revenue);

                new Chart(document.getElementById('revenueChart'), {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Doanh thu (VNĐ)',
                            data: data,
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13, 110, 253, 0.1)',
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'top' }
                        }
                    }
                });
            });

            // 2. VẼ BIỂU ĐỒ TOP SẢN PHẨM
            $.get('@Url.Action("GetTopProducts")', function (res) {
                var labels = res.map(x => x.ProductName);
                var data = res.map(x => x.Quantity);

                new Chart(document.getElementById('productChart'), {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: [
                                '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF'
                            ]
                        }]
                    },
                    options: {
                        responsive: true
                    }
                });
            });
        });
    </script>
}