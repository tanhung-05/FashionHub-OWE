# SQL Server Configuration
SA_PASSWORD=YourStrong@Passw0rd

# Use Development only for local Docker testing. Keep Production on a server.
ASPNETCORE_ENVIRONMENT=Production

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# VNPAY sandbox payment gateway
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_RETURN_URL=http://localhost:5167/payment/vnpay-return
VNPAY_TRANSACTION_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Public HTTPS URL used in password-reset emails
PUBLIC_BASE_URL=https://your-domain.example

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=OWE

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the values with your actual credentials
# 3. Never commit the .env file to version control
