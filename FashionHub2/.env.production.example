# Public hostname. Create an A record pointing this hostname to the VPS IPv4.
DOMAIN=oweshop.io.vn
ACME_EMAIL=you@example.com

# SQL Server requires a strong password. Do not reuse a personal password.
SA_PASSWORD=replace-with-a-long-random-password
APP_DB_PASSWORD=replace-with-a-different-long-random-password
MSSQL_MEMORY_LIMIT_MB=2048

# External services. Leave Gemini empty only if chat is intentionally disabled.
GEMINI_API_KEY=

# VNPAY sandbox. Rotate any key that has been shared in chat or screenshots.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-new-vnpay-hash-secret
VNPAY_RETURN_URL=https://oweshop.io.vn/payment/vnpay-return
VNPAY_TRANSACTION_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Password-reset email links must use the same public HTTPS hostname.
PUBLIC_BASE_URL=https://oweshop.io.vn
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-new-gmail-app-password
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=OWE
