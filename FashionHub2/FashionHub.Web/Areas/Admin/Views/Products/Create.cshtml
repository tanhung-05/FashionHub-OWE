@model FashionHub.Web.Areas.Admin.ViewModels.ProductAdminViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-uppercase">
                    <i class="bi bi-plus-circle me-2"></i>Thêm sản phẩm mới
                </h5>
            </div>
            <div class="card-body p-4">
                <!-- Bước 1: Thông báo quy trình -->
                <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                    <div>
                        <strong>Quy trình tạo sản phẩm:</strong><br />
                        1. Nhập thông tin chung (Tên, Giá, Danh mục...) tại đây.<br />
                        2. Sau khi lưu, hệ thống sẽ chuyển sang trang quản lý để bạn <strong>thêm Biến thể (Màu/Size)</strong> và <strong>Hình ảnh</strong>.
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <!-- Tên sản phẩm -->
                        <div class="col-12 mb-3">
                            <label asp-for="TenSanPham" class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="TenSanPham" class="form-control form-control-lg" placeholder="Ví dụ: Áo Thun Cotton Premium" />
                            <span asp-validation-for="TenSanPham" class="text-danger"></span>
                        </div>

                        <!-- Danh mục -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="IDDanhMuc" class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                            <select asp-for="IDDanhMuc" class="form-select" asp-items="ViewBag.DanhMucs">
                                <option value="">-- Chọn Danh mục --</option>
                            </select>
                            <span asp-validation-for="IDDanhMuc" class="text-danger"></span>
                        </div>

                        <!-- Thương hiệu -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="IDThuongHieu" class="form-label fw-bold">Thương hiệu <span class="text-danger">*</span></label>
                            <select asp-for="IDThuongHieu" class="form-select" asp-items="ViewBag.ThuongHieux">
                                <option value="">-- Chọn Thương hiệu --</option>
                            </select>
                            <span asp-validation-for="IDThuongHieu" class="text-danger"></span>
                        </div>

                        <!-- Giá bán -->
                        <div class="col-12 mb-3">
                            <label asp-for="Gia" class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="Gia" type="number" min="0" class="form-control" placeholder="Nhập giá bán..." />
                            <span asp-validation-for="Gia" class="text-danger"></span>
                        </div>

                        <!-- Mô tả -->
                        <div class="col-12 mb-3">
                            <label asp-for="MoTa" class="form-label fw-bold">Mô tả sản phẩm</label>
                            <textarea asp-for="MoTa" class="form-control" rows="6" placeholder="Nhập mô tả chi tiết về chất liệu, kiểu dáng..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-arrow-right me-2"></i>Tiếp tục: Thêm Biến thể
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}