@model FashionHub.Web.Areas.Admin.ViewModels.ProductAdminViewModel
@{
    ViewData["Title"] = "Quản lý sản phẩm: " + Model.TenSanPham;
    var colors = ViewBag.Colors as IEnumerable<MauSac> ?? Enumerable.Empty<MauSac>();
    var sizes = ViewBag.Sizes as IEnumerable<KichThuoc> ?? Enumerable.Empty<KichThuoc>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Quay lại danh sách
    </a>
</div>

<!-- PHẦN 1: THÔNG TIN CHUNG -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">Thông tin chung</div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="IDSanPham" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TenSanPham" class="form-label">Tên sản phẩm</label>
                    <input asp-for="TenSanPham" class="form-control" />
                    <span asp-validation-for="TenSanPham" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="IDDanhMuc" class="form-label">Danh mục</label>
                    <select asp-for="IDDanhMuc" class="form-select" asp-items="ViewBag.DanhMucs"></select>
                    <span asp-validation-for="IDDanhMuc" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="IDThuongHieu" class="form-label">Thương hiệu</label>
                    <select asp-for="IDThuongHieu" class="form-select" asp-items="ViewBag.ThuongHieux"></select>
                    <span asp-validation-for="IDThuongHieu" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Gia" class="form-label fw-bold">Giá bán (VNĐ)</label>
                <input asp-for="Gia" type="number" min="0" class="form-control" />
                <span asp-validation-for="Gia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label">Mô tả</label>
                <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
            </div>

            <div class="form-check mb-3">
                <input asp-for="TrangThai" class="form-check-input" type="checkbox" />
                <label asp-for="TrangThai" class="form-check-label">Đang bán</label>
            </div>

            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Lưu thông tin chung
            </button>
        </form>
    </div>
</div>

<!-- PHẦN 2: QUẢN LÝ BIẾN THỂ -->
<div class="card">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <span>Danh sách biến thể (Màu sắc - Kích thước)</span>
        <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addVariantModal">
            <i class="bi bi-plus-circle"></i> Thêm biến thể mới
        </button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>SKU</th>
                    <th>Màu sắc</th>
                    <th>Kích thước</th>
                    <th style="width: 250px;">Quản lý Tồn kho</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="variants-table-body">
                @if (Model.Variants != null && Model.Variants.Any())
                {
                    foreach (var v in Model.Variants)
                    {
                        <tr id="variant-row-@v.IDBienThe">
                            <td>
                                @{
                                    var mainImage = v.Images.FirstOrDefault(i => i.LaAnhChinh);
                                    if (mainImage != null)
                                    {
                                        <img src="@Url.Content(mainImage.DuongDan)" width="50" class="rounded border" alt="Variant" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No Image</span>
                                    }
                                }
                            </td>
                            <td>@v.SKU</td>
                            <td>@v.TenMau</td>
                            <td>@v.TenKichThuoc</td>
                            <td>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span>Hiện có:</span>
                                    <span class="fw-bold fs-5" id="stock-display-@v.IDBienThe">@v.SoLuongTon</span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="number" class="form-control" id="import-qty-@v.IDBienThe" placeholder="Nhập thêm..." min="1">
                                    <button type="button" class="btn btn-success btn-import-stock" data-id="@v.IDBienThe">
                                        <i class="bi bi-download"></i> Nhập
                                    </button>
                                </div>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-info text-white btn-manage-images me-1" data-id="@v.IDBienThe" title="Quản lý ảnh">
                                    <i class="bi bi-images"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger btn-delete-variant" data-id="@v.IDBienThe" title="Xóa biến thể">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center py-3">Chưa có biến thể nào. Hãy thêm mới!</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

<!-- MODAL THÊM BIẾN THỂ -->
<div class="modal fade" id="addVariantModal" tabindex="-1" aria-labelledby="addVariantModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addVariantModalLabel">Thêm biến thể mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <form id="add-variant-form">
                    <input type="hidden" name="IDSanPham" value="@Model.IDSanPham" />
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Màu sắc</label>
                            <select name="IDMauSac" class="form-select" required>
                                @foreach (var color in colors)
                                {
                                    <option value="@color.IdmauSac">@color.TenMau</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Kích thước</label>
                            <select name="IDKichThuoc" class="form-select" required>
                                @foreach (var size in sizes)
                                {
                                    <option value="@size.IdkichThuoc">@size.TenKichThuoc</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số lượng ban đầu</label>
                        <input type="number" name="SoLuongTon" class="form-control" min="0" value="0" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btn-save-variant">Lưu biến thể</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL QUẢN LÝ ẢNH -->
<div class="modal fade" id="imagesModal" tabindex="-1" aria-labelledby="imagesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imagesModalLabel">Quản lý ảnh biến thể</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="current-variant-id" />
                
                <!-- Upload ảnh mới -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Upload ảnh mới</label>
                    <input type="file" id="image-upload" class="form-control"
                           accept=".jpg,.jpeg,.png,.gif,.webp" multiple />
                    <div class="form-text">Tối đa 10 ảnh, mỗi ảnh không quá 5 MB. Ảnh đầu tiên sẽ là ảnh chính.</div>
                </div>

                <!-- Danh sách ảnh hiện tại -->
                <div id="current-images-container">
                    <label class="form-label fw-bold">Ảnh hiện tại</label>
                    <div class="row g-2" id="images-grid">
                        <p class="text-muted">Đang tải...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btn-upload-images">Upload ảnh</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const addVariantModal = bootstrap.Modal.getOrCreateInstance(
        document.getElementById('addVariantModal'));
    const imagesModal = bootstrap.Modal.getOrCreateInstance(
        document.getElementById('imagesModal'));
    const imageGrid = document.getElementById('images-grid');
    const variantInput = document.getElementById('current-variant-id');

    async function run(action) {
        try {
            await action();
        } catch (error) {
            AdminUI.showToast('error', error.message || 'Không thể kết nối đến máy chủ.');
        }
    }

    document.getElementById('btn-save-variant').addEventListener('click', function () {
        const button = this;
        const form = document.getElementById('add-variant-form');
        if (!form.reportValidity()) {
            return;
        }

        run(async function () {
            const response = await AdminUI.postForm(
                '@Url.Action("AddVariant", "Products", new { area = "Admin" })',
                new FormData(form),
                button);
            if (!response.success) {
                throw new Error(response.message || 'Không thể thêm biến thể.');
            }
            AdminUI.showToast('success', response.message);
            addVariantModal.hide();
            window.location.reload();
        });
    });

    document.querySelectorAll('.btn-delete-variant').forEach(function (button) {
        button.addEventListener('click', function () {
            const variantId = button.dataset.id;
            if (!window.confirm('Xóa biến thể này? Biến thể sẽ ngừng hoạt động.')) {
                return;
            }

            run(async function () {
                const response = await AdminUI.postForm(
                    '@Url.Action("DeleteVariant", "Products", new { area = "Admin" })',
                    { id: variantId },
                    button);
                if (!response.success) {
                    throw new Error(response.message || 'Không thể xóa biến thể.');
                }
                document.getElementById('variant-row-' + variantId)?.remove();
                AdminUI.showToast('success', 'Đã xóa biến thể.');
            });
        });
    });

    document.querySelectorAll('.btn-import-stock').forEach(function (button) {
        button.addEventListener('click', function () {
            const variantId = button.dataset.id;
            const quantityInput = document.getElementById('import-qty-' + variantId);
            const quantity = Number.parseInt(quantityInput.value, 10);
            if (!Number.isInteger(quantity) || quantity < 1) {
                AdminUI.showToast('error', 'Vui lòng nhập số lượng lớn hơn 0.');
                quantityInput.focus();
                return;
            }

            run(async function () {
                const response = await AdminUI.postForm(
                    '@Url.Action("ImportStock", "Products", new { area = "Admin" })',
                    { variantId, quantityToAdd: quantity },
                    button);
                if (!response.success) {
                    throw new Error(response.message || 'Không thể nhập kho.');
                }
                document.getElementById('stock-display-' + variantId).textContent = response.newStock;
                quantityInput.value = '';
                AdminUI.showToast('success', response.message);
            });
        });
    });

    async function loadImages(variantId) {
        imageGrid.innerHTML = '<p class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải ảnh...</p>';
        const url = new URL(
            '@Url.Action("GetVariantImages", "Products", new { area = "Admin" })',
            window.location.origin);
        url.searchParams.set('variantId', variantId);
        const response = await fetch(url, { credentials: 'same-origin' });
        const payload = await AdminUI.parseResponse(response);
        if (!payload.success) {
            throw new Error(payload.message || 'Không thể tải ảnh.');
        }
        renderImages(payload.data || []);
    }

    document.querySelectorAll('.btn-manage-images').forEach(function (button) {
        button.addEventListener('click', function () {
            const variantId = button.dataset.id;
            variantInput.value = variantId;
            imagesModal.show();
            run(function () { return loadImages(variantId); });
        });
    });

    document.getElementById('btn-upload-images').addEventListener('click', function () {
        const button = this;
        const files = document.getElementById('image-upload').files;
        if (files.length === 0) {
            AdminUI.showToast('error', 'Vui lòng chọn ít nhất một ảnh.');
            return;
        }

        const formData = new FormData();
        formData.append('variantId', variantInput.value);
        Array.from(files).forEach(function (file) {
            formData.append('images', file);
        });

        run(async function () {
            const response = await AdminUI.postForm(
                '@Url.Action("UploadImages", "Products", new { area = "Admin" })',
                formData,
                button);
            if (!response.success) {
                throw new Error(response.message || 'Không thể tải ảnh.');
            }
            document.getElementById('image-upload').value = '';
            AdminUI.showToast('success', response.message);
            await loadImages(variantInput.value);
        });
    });

    function renderImages(images) {
        imageGrid.replaceChildren();
        if (images.length === 0) {
            const empty = document.createElement('p');
            empty.className = 'text-muted';
            empty.textContent = 'Chưa có ảnh nào.';
            imageGrid.append(empty);
            return;
        }

        images.forEach(function (image) {
            const column = document.createElement('div');
            column.className = 'col-6 col-md-3';
            const frame = document.createElement('div');
            frame.className = 'position-relative border rounded p-1 h-100';
            const preview = document.createElement('img');
            preview.src = image.url;
            preview.alt = image.isMain ? 'Ảnh chính của biến thể' : 'Ảnh biến thể';
            preview.className = 'img-fluid rounded w-100';
            preview.style.aspectRatio = '1 / 1';
            preview.style.objectFit = 'cover';
            frame.append(preview);

            const actions = document.createElement('div');
            actions.className = 'd-flex gap-1 mt-1';
            if (!image.isMain) {
                const setMain = document.createElement('button');
                setMain.type = 'button';
                setMain.className = 'btn btn-sm btn-outline-success flex-grow-1';
                setMain.innerHTML = '<i class="bi bi-star" aria-hidden="true"></i>';
                setMain.title = 'Đặt làm ảnh chính';
                setMain.addEventListener('click', function () {
                    run(async function () {
                        const response = await AdminUI.postForm(
                            '@Url.Action("SetMainImage", "Products", new { area = "Admin" })',
                            { variantId: variantInput.value, imageId: image.id },
                            setMain);
                        if (!response.success) {
                            throw new Error(response.message || 'Không thể đặt ảnh chính.');
                        }
                        await loadImages(variantInput.value);
                    });
                });
                actions.append(setMain);
            } else {
                const badge = document.createElement('span');
                badge.className = 'badge bg-success flex-grow-1 align-content-center';
                badge.textContent = 'Ảnh chính';
                actions.append(badge);
            }

            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'btn btn-sm btn-outline-danger';
            remove.innerHTML = '<i class="bi bi-trash" aria-hidden="true"></i>';
            remove.title = 'Xóa ảnh';
            remove.addEventListener('click', function () {
                if (!window.confirm('Bạn có chắc muốn xóa ảnh này?')) {
                    return;
                }
                run(async function () {
                    const response = await AdminUI.postForm(
                        '@Url.Action("DeleteImage", "Products", new { area = "Admin" })',
                        { variantId: variantInput.value, imageId: image.id },
                        remove);
                    if (!response.success) {
                        throw new Error(response.message || 'Không thể xóa ảnh.');
                    }
                    await loadImages(variantInput.value);
                });
            });
            actions.append(remove);
            frame.append(actions);
            column.append(frame);
            imageGrid.append(column);
        });
    }
})();
</script>
<partial name="_ValidationScriptsPartial" />
}
