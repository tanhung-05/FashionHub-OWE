@model FashionHub.Web.Areas.Admin.ViewModels.ProductAdminViewModel
@{
    ViewData["Title"] = "Quản lý sản phẩm: " + Model.TenSanPham;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>

<!-- PHẦN 1: THÔNG TIN CHUNG -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">Thông tin chung</div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="IDSanPham" />
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TenSanPham" class="form-label">Tên sản phẩm</label>
                    <input asp-for="TenSanPham" class="form-control" />
                    <span asp-validation-for="TenSanPham" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="IDDanhMuc" class="form-label">Danh mục</label>
                    <select asp-for="IDDanhMuc" class="form-select" asp-items="ViewBag.DanhMucs"></select>
                    <span asp-validation-for="IDDanhMuc" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="IDThuongHieu" class="form-label">Thương hiệu</label>
                    <select asp-for="IDThuongHieu" class="form-select" asp-items="ViewBag.ThuongHieux"></select>
                    <span asp-validation-for="IDThuongHieu" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Gia" class="form-label fw-bold">Giá bán (VNĐ)</label>
                <input asp-for="Gia" type="number" min="0" class="form-control" />
                <span asp-validation-for="Gia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label">Mô tả</label>
                <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
            </div>

            <div class="form-check mb-3">
                <input asp-for="TrangThai" class="form-check-input" type="checkbox" />
                <label asp-for="TrangThai" class="form-check-label">Đang bán</label>
            </div>

            <button type="submit" class="btn btn-success">Lưu thông tin chung</button>
        </form>
    </div>
</div>

<!-- PHẦN 2: QUẢN LÝ BIẾN THỂ -->
<div class="card">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <span>Danh sách biến thể (Màu sắc - Kích thước)</span>
        <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addVariantModal">
            <i class="bi bi-plus-circle"></i> Thêm biến thể mới
        </button>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>SKU</th>
                    <th>Màu sắc</th>
                    <th>Kích thước</th>
                    <th style="width: 250px;">Quản lý Tồn kho</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="variants-table-body">
                @if (Model.Variants != null && Model.Variants.Any())
                {
                    foreach (var v in Model.Variants)
                    {
                        <tr id="variant-row-@v.IDBienThe">
                            <td>
                                @{
                                    var mainImage = v.Images.FirstOrDefault(i => i.LaAnhChinh);
                                    if (mainImage != null)
                                    {
                                        <img src="@Url.Content(mainImage.DuongDan)" width="50" class="rounded border" alt="Variant" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No Image</span>
                                    }
                                }
                            </td>
                            <td>@v.SKU</td>
                            <td>@v.TenMau</td>
                            <td>@v.TenKichThuoc</td>
                            <td>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span>Hiện có:</span>
                                    <span class="fw-bold fs-5" id="stock-display-@v.IDBienThe">@v.SoLuongTon</span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="number" class="form-control" id="import-qty-@v.IDBienThe" placeholder="Nhập thêm..." min="1">
                                    <button class="btn btn-success btn-import-stock" data-id="@v.IDBienThe">
                                        <i class="bi bi-download"></i> Nhập
                                    </button>
                                </div>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-info text-white btn-manage-images me-1" data-id="@v.IDBienThe" title="Quản lý ảnh">
                                    <i class="bi bi-images"></i>
                                </button>
                                <button class="btn btn-sm btn-danger btn-delete-variant" data-id="@v.IDBienThe" title="Xóa biến thể">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center py-3">Chưa có biến thể nào. Hãy thêm mới!</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL THÊM BIẾN THỂ -->
<div class="modal fade" id="addVariantModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm biến thể mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="add-variant-form">
                    <input type="hidden" name="productId" value="@Model.IDSanPham" />
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Màu sắc</label>
                            <select name="colorId" class="form-select">
                                @foreach (var color in ViewBag.Colors as List<FashionHub.Web.Models.Generated.MauSac>)
                                {
                                    <option value="@color.IdmauSac">@color.TenMau</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Kích thước</label>
                            <select name="sizeId" class="form-select">
                                @foreach (var size in ViewBag.Sizes as List<FashionHub.Web.Models.Generated.KichThuoc>)
                                {
                                    <option value="@size.IdkichThuoc">@size.TenKichThuoc</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số lượng ban đầu</label>
                        <input type="number" name="initialStock" class="form-control" min="0" value="0" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btn-save-variant">Lưu biến thể</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL QUẢN LÝ ẢNH -->
<div class="modal fade" id="imagesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Quản lý ảnh biến thể</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="current-variant-id" />
                
                <!-- Upload ảnh mới -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Upload ảnh mới</label>
                    <input type="file" id="image-upload" class="form-control" accept="image/*" multiple />
                    <div class="form-text">Chọn nhiều ảnh cùng lúc. Ảnh đầu tiên sẽ là ảnh chính.</div>
                </div>

                <!-- Danh sách ảnh hiện tại -->
                <div id="current-images-container">
                    <label class="form-label fw-bold">Ảnh hiện tại</label>
                    <div class="row g-2" id="images-grid">
                        <p class="text-muted">Đang tải...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btn-upload-images">Upload ảnh</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    // Thêm biến thể
    $('#btn-save-variant').on('click', function() {
        const formData = $('#add-variant-form').serialize();
        
        $.ajax({
            url: '@Url.Action("AddVariant")',
            type: 'POST',
            data: formData,
            success: function(response) {
                if (response.success) {
                    showToast('success', 'Thêm biến thể thành công!');
                    $('#addVariantModal').modal('hide');
                    location.reload();
                } else {
                    showToast('error', response.message || 'Có lỗi xảy ra!');
                }
            },
            error: function() {
                showToast('error', 'Lỗi kết nối server!');
            }
        });
    });

    // Xóa biến thể
    $('.btn-delete-variant').on('click', function() {
        const variantId = $(this).data('id');
        
        if (confirm('Bạn có chắc muốn xóa biến thể này?')) {
            $.ajax({
                url: '@Url.Action("DeleteVariant")',
                type: 'POST',
                data: { id: variantId },
                success: function(response) {
                    if (response.success) {
                        showToast('success', 'Xóa biến thể thành công!');
                        $('#variant-row-' + variantId).remove();
                    } else {
                        showToast('error', response.message || 'Có lỗi xảy ra!');
                    }
                },
                error: function() {
                    showToast('error', 'Lỗi kết nối server!');
                }
            });
        }
    });

    // Nhập kho
    $('.btn-import-stock').on('click', function() {
        const variantId = $(this).data('id');
        const qty = parseInt($('#import-qty-' + variantId).val());
        
        if (!qty || qty < 1) {
            showToast('error', 'Vui lòng nhập số lượng hợp lệ!');
            return;
        }

        $.ajax({
            url: '@Url.Action("ImportStock")',
            type: 'POST',
            data: { variantId: variantId, quantity: qty },
            success: function(response) {
                if (response.success) {
                    showToast('success', 'Nhập kho thành công!');
                    $('#stock-display-' + variantId).text(response.newStock);
                    $('#import-qty-' + variantId).val('');
                } else {
                    showToast('error', response.message || 'Có lỗi xảy ra!');
                }
            },
            error: function() {
                showToast('error', 'Lỗi kết nối server!');
            }
        });
    });

    // Quản lý ảnh
    $('.btn-manage-images').on('click', function() {
        const variantId = $(this).data('id');
        $('#current-variant-id').val(variantId);
        
        // Load ảnh hiện tại
        $.ajax({
            url: '@Url.Action("GetVariantImages")',
            type: 'GET',
            data: { variantId: variantId },
            success: function(response) {
                if (response.success) {
                    renderImages(response.images);
                    $('#imagesModal').modal('show');
                } else {
                    showToast('error', 'Không thể tải ảnh!');
                }
            }
        });
    });

    // Upload ảnh
    $('#btn-upload-images').on('click', function() {
        const variantId = $('#current-variant-id').val();
        const files = $('#image-upload')[0].files;
        
        if (files.length === 0) {
            showToast('error', 'Vui lòng chọn ảnh!');
            return;
        }

        const formData = new FormData();
        formData.append('variantId', variantId);
        for (let i = 0; i < files.length; i++) {
            formData.append('images', files[i]);
        }

        $.ajax({
            url: '@Url.Action("UploadImages")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.success) {
                    showToast('success', 'Upload ảnh thành công!');
                    $('#image-upload').val('');
                    location.reload();
                } else {
                    showToast('error', response.message || 'Có lỗi xảy ra!');
                }
            },
            error: function() {
                showToast('error', 'Lỗi upload ảnh!');
            }
        });
    });

    function renderImages(images) {
        const grid = $('#images-grid');
        grid.empty();
        
        if (images.length === 0) {
            grid.append('<p class="text-muted">Chưa có ảnh nào.</p>');
            return;
        }

        images.forEach(function(img) {
            const col = $('<div class="col-md-3 position-relative"></div>');
            const imgTag = $('<img src="' + img.url + '" class="img-fluid rounded border" />');
            const badge = img.isMain ? '<span class="position-absolute top-0 end-0 badge bg-success m-1">Chính</span>' : '';
            const deleteBtn = '<button class="btn btn-sm btn-danger position-absolute bottom-0 end-0 m-1 btn-delete-image" data-id="' + img.id + '"><i class="bi bi-trash"></i></button>';
            
            col.append(imgTag).append(badge).append(deleteBtn);
            grid.append(col);
        });

        // Bind delete event
        $('.btn-delete-image').on('click', function() {
            const imageId = $(this).data('id');
            deleteImage(imageId);
        });
    }

    function deleteImage(imageId) {
        if (confirm('Xóa ảnh này?')) {
            $.ajax({
                url: '@Url.Action("DeleteImage")',
                type: 'POST',
                data: { imageId: imageId },
                success: function(response) {
                    if (response.success) {
                        showToast('success', 'Xóa ảnh thành công!');
                        const variantId = $('#current-variant-id').val();
                        $('.btn-manage-images[data-id="' + variantId + '"]').click();
                    } else {
                        showToast('error', response.message || 'Có lỗi xảy ra!');
                    }
                }
            });
        }
    }

    function showToast(type, message) {
        const toastClass = type === 'success' ? 'bg-success' : 'bg-danger';
        const toastHtml = `
            <div class="toast align-items-center text-white ${toastClass} border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        `;
        
        const toastContainer = $('.toast-container');
        if (toastContainer.length === 0) {
            $('body').append('<div class="toast-container position-fixed top-0 end-0 p-3"></div>');
        }
        
        $('.toast-container').append(toastHtml);
        const toast = new bootstrap.Toast($('.toast:last'));
        toast.show();
    }
});
</script>
<partial name="_ValidationScriptsPartial" />
}