@model FashionHub.Web.Areas.Admin.ViewModels.ProductListAdminViewModel
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    var categories = ViewBag.DanhMucs as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var brands = ViewBag.ThuongHieux as IEnumerable<ThuongHieu>
        ?? Enumerable.Empty<ThuongHieu>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="fw-bold text-uppercase mb-1">
            @(Model.ShowDeleted ? "Sản phẩm đã ngừng kinh doanh" : "Danh sách Sản phẩm")
        </h4>
        <div class="btn-group btn-group-sm" role="group" aria-label="Phạm vi sản phẩm">
            <a asp-action="Index"
               asp-route-showDeleted="false"
               class="btn @(Model.ShowDeleted ? "btn-outline-secondary" : "btn-secondary")">
                <i class="bi bi-box-seam"></i> Đang quản lý
            </a>
            <a asp-action="Index"
               asp-route-showDeleted="true"
               class="btn @(Model.ShowDeleted ? "btn-secondary" : "btn-outline-secondary")">
                <i class="bi bi-archive"></i> Đã ẩn
            </a>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Export" class="btn btn-success me-2">
            <i class="bi bi-file-earmark-spreadsheet"></i> Xuất Excel
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm mới
        </a>
    </div>
</div>

<!-- THANH CÔNG CỤ TÌM KIẾM & LỌC -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light rounded">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <input type="hidden"
                   name="showDeleted"
                   value="@(Model.ShowDeleted ? "true" : "false")">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" class="form-control" placeholder="Tên sản phẩm..." value="@Model.SearchString">
                </div>
            </div>
            <div class="col-md-2">
                <select name="categoryId" class="form-select">
                    <option value="">-- Danh mục --</option>
                    @foreach (var item in categories)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="brandId" class="form-select">
                    <option value="">-- Thương hiệu --</option>
                    @foreach (var item in brands)
                    {
                        <option value="@item.IdthuongHieu" selected="@(Model.BrandId == item.IdthuongHieu)">@item.TenThuongHieu</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select" disabled="@Model.ShowDeleted">
                    <option value="">-- Trạng thái --</option>
                    <option value="1" selected="@(Model.Status == 1)">Đang bán</option>
                    <option value="0" selected="@(Model.Status == 0)">Ngừng bán</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-dark w-100"><i class="bi bi-funnel"></i> Lọc dữ liệu</button>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DỮ LIỆU -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Phân loại</th>
                        <th>Thống kê</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Products.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy sản phẩm nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Products)
                        {
                            <tr class="@(item.IsDeleted ? "table-secondary" : null)">
                                <td class="ps-4 fw-bold text-secondary">#@item.IDSanPham</td>
                                <td>
                                    <div class="position-relative" style="width: 60px; height: 60px;">
                                        @if (!string.IsNullOrEmpty(item.MainImageUrl))
                                        {
                                            <img src="@Url.Content(item.MainImageUrl)" class="rounded border w-100 h-100" style="object-fit: cover;" alt="@item.TenSanPham">
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded border w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            @item.VariantCount
                                            <span class="visually-hidden">biến thể</span>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.IsDeleted)
                                    {
                                        <strong class="text-dark">@item.TenSanPham</strong>
                                        @if (item.DeletedAt.HasValue)
                                        {
                                            <div class="small text-muted mt-1">
                                                Ẩn lúc @item.DeletedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.IDSanPham" class="text-decoration-none fw-bold text-dark">
                                            @item.TenSanPham
                                        </a>
                                    }
                                    <div class="small text-danger fw-bold mt-1">
                                        @if (item.GiaKhuyenMai.HasValue)
                                        {
                                            <span>@item.GiaKhuyenMai.Value.ToString("N0") đ</span>
                                            <span class="text-muted text-decoration-line-through ms-1 fw-normal">@item.Gia.ToString("N0") đ</span>
                                        }
                                        else
                                        {
                                            <span>@item.Gia.ToString("N0") đ</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="small"><span class="text-muted">DM:</span> @item.TenDanhMuc</div>
                                    <div class="small"><span class="text-muted">TH:</span> @item.TenThuongHieu</div>
                                </td>
                                <td>
                                    @if (item.TotalStock > 0)
                                    {
                                        <span class="badge bg-light text-dark border">Kho: @item.TotalStock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Hết hàng</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsDeleted)
                                    {
                                        <span class="badge bg-dark-subtle text-dark border">
                                            Đã ngừng kinh doanh
                                        </span>
                                    }
                                    else if (item.TrangThai)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Ngừng bán</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (item.IsDeleted)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success btn-restore-product"
                                                data-id="@item.IDSanPham"
                                                title="Khôi phục sản phẩm">
                                            <i class="bi bi-arrow-counterclockwise"></i> Khôi phục
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.IDSanPham" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-warning text-dark btn-discount"
                                                data-id="@item.IDSanPham"
                                                data-price="@item.Gia.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-km-price="@((item.GiaKhuyenMai ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                data-start="@item.NgayBatDauKm?.ToString("yyyy-MM-dd")"
                                                data-end="@item.NgayKetThucKm?.ToString("yyyy-MM-dd")"
                                                title="Tạo chương trình khuyến mãi">
                                            <i class="bi bi-percent"></i> KM
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-delete-product"
                                                data-id="@item.IDSanPham"
                                                title="Ngừng kinh doanh">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL KHUYẾN MÃI -->
<div class="modal fade" id="discountModal" tabindex="-1" aria-labelledby="discountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title fw-bold" id="discountModalLabel">Thiết lập Khuyến mãi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="discount-product-id">
                <input type="hidden" id="discount-original-price-hidden">

                <div class="mb-3">
                    <label class="form-label">Giá gốc:</label>
                    <input type="text" id="discount-original-price-display" class="form-control fw-bold" disabled>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Giảm giá (%):</label>
                        <div class="input-group">
                            <input type="number" id="discount-percent" class="form-control" min="0" max="100" value="0">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Giá sau giảm:</label>
                        <input type="text" id="discount-new-price" class="form-control fw-bold text-danger" disabled>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Ngày bắt đầu:</label>
                        <input type="date" id="discount-start-date" class="form-control">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Ngày kết thúc:</label>
                        <input type="date" id="discount-end-date" class="form-control">
                    </div>
                </div>

                <div class="alert alert-info small mb-0">
                    <i class="bi bi-info-circle"></i> Để hủy khuyến mãi, nhập % = 0 và lưu lại.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-warning" id="btn-save-discount">Lưu khuyến mãi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const modalElement = document.getElementById('discountModal');
    const discountModal = bootstrap.Modal.getOrCreateInstance(modalElement);
    const productIdInput = document.getElementById('discount-product-id');
    const priceInput = document.getElementById('discount-original-price-hidden');
    const priceDisplay = document.getElementById('discount-original-price-display');
    const percentInput = document.getElementById('discount-percent');
    const newPriceDisplay = document.getElementById('discount-new-price');
    const startInput = document.getElementById('discount-start-date');
    const endInput = document.getElementById('discount-end-date');

    function updateDiscountPrice() {
        const percent = Number.parseInt(percentInput.value, 10) || 0;
        const originalPrice = Number.parseFloat(priceInput.value) || 0;
        const newPrice = originalPrice - (originalPrice * percent / 100);
        newPriceDisplay.value = newPrice.toLocaleString('vi-VN') + ' đ';
    }

    document.querySelectorAll('.btn-discount').forEach(function (button) {
        button.addEventListener('click', function () {
            const price = Number.parseFloat(button.dataset.price);
            const salePrice = Number.parseFloat(button.dataset.kmPrice) || 0;
            productIdInput.value = button.dataset.id;
            priceInput.value = price;
            priceDisplay.value = price.toLocaleString('vi-VN') + ' đ';
            percentInput.value = salePrice > 0 && salePrice < price
                ? Math.round(((price - salePrice) / price) * 100)
                : 0;
            startInput.value = button.dataset.start || '';
            endInput.value = button.dataset.end || '';
            updateDiscountPrice();
            discountModal.show();
        });
    });

    percentInput.addEventListener('input', updateDiscountPrice);

    document.getElementById('btn-save-discount').addEventListener('click', async function () {
        const button = this;
        const discountPercent = Number.parseInt(percentInput.value, 10) || 0;
        if (discountPercent < 0 || discountPercent > 100) {
            AdminUI.showToast('error', 'Phần trăm giảm giá phải từ 0 đến 100.');
            return;
        }
        if (discountPercent > 0 && startInput.value && endInput.value && endInput.value <= startInput.value) {
            AdminUI.showToast('error', 'Ngày kết thúc phải sau ngày bắt đầu.');
            return;
        }

        try {
            const response = await AdminUI.postForm(
                '@Url.Action("ApplyDiscount", "Products", new { area = "Admin" })',
                {
                    id: productIdInput.value,
                    discountPercent,
                    startDate: startInput.value,
                    endDate: endInput.value
                },
                button);
            if (!response.success) {
                throw new Error(response.message || 'Không thể cập nhật khuyến mãi.');
            }
            AdminUI.showToast('success', response.message);
            discountModal.hide();
            window.location.reload();
        } catch (error) {
            AdminUI.showToast('error', error.message || 'Không thể kết nối đến máy chủ.');
        }
    });

    document.querySelectorAll('.btn-delete-product').forEach(function (button) {
        button.addEventListener('click', async function () {
            if (!window.confirm(
                'Ngừng kinh doanh sản phẩm này? Sản phẩm sẽ được ẩn khỏi cửa hàng, ' +
                'nhưng dữ liệu và đơn hàng cũ vẫn được giữ lại.')) {
                return;
            }

            try {
                const response = await AdminUI.postForm(
                    '@Url.Action("Delete", "Products", new { area = "Admin" })',
                    { id: button.dataset.id },
                    button);
                if (!response.success) {
                    throw new Error(response.message || 'Không thể ngừng kinh doanh sản phẩm.');
                }
                AdminUI.showToast('success', response.message);
                window.location.reload();
            } catch (error) {
                AdminUI.showToast('error', error.message || 'Không thể kết nối đến máy chủ.');
            }
        });
    });

    document.querySelectorAll('.btn-restore-product').forEach(function (button) {
        button.addEventListener('click', async function () {
            if (!window.confirm(
                'Khôi phục sản phẩm này? Sản phẩm sẽ trở lại danh sách quản lý ' +
                'ở trạng thái Ngừng bán để bạn kiểm tra trước khi mở bán.')) {
                return;
            }

            try {
                const response = await AdminUI.postForm(
                    '@Url.Action("Restore", "Products", new { area = "Admin" })',
                    { id: button.dataset.id },
                    button);
                if (!response.success) {
                    throw new Error(response.message || 'Không thể khôi phục sản phẩm.');
                }
                AdminUI.showToast('success', response.message);
                window.location.reload();
            } catch (error) {
                AdminUI.showToast('error', error.message || 'Không thể kết nối đến máy chủ.');
            }
        });
    });
})();
</script>
}
