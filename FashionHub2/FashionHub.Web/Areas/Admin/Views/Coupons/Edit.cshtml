@model FashionHub.Web.Areas.Admin.ViewModels.CouponViewModel
@{
    ViewData["Title"] = "Sửa mã giảm giá";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input asp-for="IdmaGiamGia" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MaCode" class="form-label"></label>
                    <input asp-for="MaCode" class="form-control" />
                    <span asp-validation-for="MaCode" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TenChuongTrinh" class="form-label"></label>
                    <input asp-for="TenChuongTrinh" class="form-control" />
                    <span asp-validation-for="TenChuongTrinh" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="LoaiGiamGia" class="form-label"></label>
                    <select asp-for="LoaiGiamGia" class="form-select">
                        <option value="1">Số tiền cố định (₫)</option>
                        <option value="2">Phần trăm (%)</option>
                    </select>
                    <span asp-validation-for="LoaiGiamGia" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="GiaTri" class="form-label"></label>
                    <input asp-for="GiaTri" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="GiaTri" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DonHangToiThieu" class="form-label"></label>
                    <input asp-for="DonHangToiThieu" type="number" step="1000" class="form-control" />
                    <span asp-validation-for="DonHangToiThieu" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="GiamToiDa" class="form-label"></label>
                    <input asp-for="GiamToiDa" type="number" step="1000" class="form-control" />
                    <span asp-validation-for="GiamToiDa" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="SoLuong" class="form-label"></label>
                    <input asp-for="SoLuong" type="number" class="form-control" />
                    <span asp-validation-for="SoLuong" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="DaSuDung" class="form-label"></label>
                    <input asp-for="DaSuDung" type="number" class="form-control" readonly />
                    <small class="text-muted">Số lần đã sử dụng (chỉ đọc)</small>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="TrangThai" class="form-label"></label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="true">Hoạt động</option>
                        <option value="false">Tắt</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="NgayBatDau" class="form-label"></label>
                    <input asp-for="NgayBatDau" type="date" class="form-control" />
                    <span asp-validation-for="NgayBatDau" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="NgayKetThuc" class="form-label"></label>
                    <input asp-for="NgayKetThuc" type="date" class="form-control" />
                    <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Cập nhật
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
