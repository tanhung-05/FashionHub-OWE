@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var adminName = User.FindFirstValue("FullName")
        ?? User.Identity?.Name
        ?? "Quản trị viên";
    var adminEmail = User.FindFirstValue(ClaimTypes.Email)
        ?? User.Identity?.Name
        ?? string.Empty;
    var avatarLetter = string.IsNullOrWhiteSpace(adminName)
        ? "A"
        : adminName.Trim()[0].ToString().ToUpperInvariant();

    string ActiveFor(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OWE Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <aside class="admin-sidebar" id="adminSidebar" aria-label="Điều hướng quản trị">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-brand">
            <span class="admin-brand-mark" aria-hidden="true"><i class="bi bi-gem"></i></span>
            <span>
                <span class="admin-brand-name d-block">OWE</span>
                <span class="admin-brand-caption d-block">Administrator</span>
            </span>
        </a>

        <nav class="admin-nav">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="nav-link @ActiveFor("Dashboard")"
               aria-current="@(currentController == "Dashboard" ? "page" : null)">
                <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>
                <span>Tổng quan</span>
            </a>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
               class="nav-link @ActiveFor("Orders")"
               aria-current="@(currentController == "Orders" ? "page" : null)">
                <i class="bi bi-receipt" aria-hidden="true"></i>
                <span>Đơn hàng</span>
            </a>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index"
               class="nav-link @ActiveFor("Products")"
               aria-current="@(currentController == "Products" ? "page" : null)">
                <i class="bi bi-box-seam-fill" aria-hidden="true"></i>
                <span>Sản phẩm</span>
            </a>
            <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
               class="nav-link @ActiveFor("Categories")"
               aria-current="@(currentController == "Categories" ? "page" : null)">
                <i class="bi bi-folder-fill" aria-hidden="true"></i>
                <span>Danh mục</span>
            </a>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index"
               class="nav-link @ActiveFor("Users")"
               aria-current="@(currentController == "Users" ? "page" : null)">
                <i class="bi bi-people-fill" aria-hidden="true"></i>
                <span>Khách hàng</span>
            </a>
            <a asp-area="Admin" asp-controller="Coupons" asp-action="Index"
               class="nav-link @ActiveFor("Coupons")"
               aria-current="@(currentController == "Coupons" ? "page" : null)">
                <i class="bi bi-ticket-perforated" aria-hidden="true"></i>
                <span>Mã giảm giá</span>
            </a>
            <a asp-area="Admin" asp-controller="Reports" asp-action="Index"
               class="nav-link @ActiveFor("Reports")"
               aria-current="@(currentController == "Reports" ? "page" : null)">
                <i class="bi bi-bar-chart" aria-hidden="true"></i>
                <span>Báo cáo</span>
            </a>

            <div class="admin-nav-secondary">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link">
                    <i class="bi bi-shop-window" aria-hidden="true"></i>
                    <span>Quay lại cửa hàng</span>
                </a>
            </div>
        </nav>
    </aside>
    <button type="button" class="admin-sidebar-backdrop border-0" data-admin-sidebar-close
            aria-label="Đóng menu quản trị"></button>

    <div class="admin-shell">
        <header class="admin-header">
            <div class="d-flex align-items-center gap-2 overflow-hidden">
                <button type="button" class="btn btn-outline-dark admin-sidebar-toggle"
                        data-admin-sidebar-toggle aria-controls="adminSidebar"
                        aria-expanded="false" aria-label="Mở menu quản trị">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
                <div class="overflow-hidden">
                    <h1 class="admin-page-title">@ViewData["Title"]</h1>
                    <div class="small text-muted d-none d-md-block">
                        @currentController / @currentAction
                    </div>
                </div>
            </div>

            <div class="dropdown">
                <button type="button" class="btn border-0 d-flex align-items-center gap-2 p-0"
                        id="adminAccountMenu" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="admin-identity text-end d-none d-sm-block">
                        <span class="admin-identity-name d-block fw-bold">@adminName</span>
                        <span class="admin-identity-email d-block">@adminEmail</span>
                    </span>
                    <span class="admin-avatar" aria-hidden="true">@avatarLetter</span>
                    <i class="bi bi-chevron-down small" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm mt-2" aria-labelledby="adminAccountMenu">
                    <li>
                        <a class="dropdown-item py-2" asp-area="" asp-controller="Account" asp-action="Profile">
                            <i class="bi bi-person me-2" aria-hidden="true"></i>Hồ sơ tài khoản
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item py-2 text-danger">
                                <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Đăng xuất
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        <main class="admin-content">
            <form id="adminAntiforgeryForm" class="d-none" aria-hidden="true">
                @Html.AntiForgeryToken()
            </form>

            @if (TempData["Success"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["SuccessMessage"] is string alternateSuccessMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@alternateSuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>@errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string alternateErrorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>@alternateErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }

            @RenderBody()
        </main>

        <footer class="admin-footer">
            &copy; @DateTime.Now.Year <strong>OWE Fashion</strong> · Khu vực quản trị
        </footer>
    </div>

    <div class="toast-container admin-toast-container position-fixed top-0 end-0 p-3"></div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
