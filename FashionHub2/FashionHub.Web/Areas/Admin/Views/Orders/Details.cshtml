@model FashionHub.Web.Models.Generated.DonHang

@{
    ViewBag.Title = $"Chi tiết Đơn hàng #{Model.IddonHang}";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <a asp-action="Invoice" asp-route-id="@Model.IddonHang" class="btn btn-outline-primary" target="_blank">
        <i class="bi bi-printer"></i> In hóa đơn
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-receipt me-2"></i>Đơn hàng #@Model.IddonHang
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ChiTietDonHangs.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">Không có chi tiết đơn hàng.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.ChiTietDonHangs)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.TenSanPham</div>
                                            @if (!string.IsNullOrEmpty(item.TenMau) || !string.IsNullOrEmpty(item.TenKichThuoc))
                                            {
                                                <small class="text-muted">
                                                    @if (!string.IsNullOrEmpty(item.TenMau))
                                                    {
                                                        <span>Màu: @item.TenMau</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.TenKichThuoc))
                                                    {
                                                        <span class="ms-2">Size: @item.TenKichThuoc</span>
                                                    }
                                                </small>
                                            }
                                        </td>
                                        <td class="text-center">@item.SoLuong</td>
                                        <td class="text-end">@item.DonGia.ToString("N0") đ</td>
                                        <td class="text-end fw-bold">@((item.SoLuong * item.DonGia).ToString("N0")) đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <hr class="my-3" />

                <div class="row">
                    <div class="col-md-6 offset-md-6">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tổng tiền hàng:</span>
                            <strong>@Model.TongTienHang.ToString("N0") đ</strong>
                        </div>
                        @if (Model.PhiVanChuyen.HasValue && Model.PhiVanChuyen.Value > 0)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Phí vận chuyển:</span>
                                <strong>@Model.PhiVanChuyen.Value.ToString("N0") đ</strong>
                            </div>
                        }
                        @if (Model.TienGiamGia.HasValue && Model.TienGiamGia.Value > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Giảm giá:</span>
                                <strong>-@Model.TienGiamGia.Value.ToString("N0") đ</strong>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between fs-5">
                            <strong>Tổng thanh toán:</strong>
                            <strong class="text-primary">@Model.TongThanhToan.ToString("N0") đ</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="bi bi-person me-2"></i>Thông tin khách hàng
                </h6>
            </div>
            <div class="card-body">
                <p class="mb-2">
                    <strong>Tên:</strong> @Model.TenNguoiNhan
                </p>
                <p class="mb-2">
                    <strong>SĐT:</strong> @Model.SoDienThoai
                </p>
                <p class="mb-0">
                    <strong>Địa chỉ:</strong><br />
                    @Model.DiaChiGiao
                </p>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="bi bi-info-circle me-2"></i>Trạng thái & Thanh toán
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="UpdateStatus" asp-route-id="@Model.IddonHang" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="idTrangThai" class="form-label fw-bold">Trạng thái đơn hàng</label>
                        <select id="idTrangThai" name="idTrangThai" class="form-select">
                            @foreach (var item in (ViewBag.StatusList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)!)
                            {
                                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-arrow-repeat"></i> Cập nhật trạng thái
                    </button>
                </form>

                <hr />

                <p class="mb-2">
                    <strong>Phương thức thanh toán:</strong><br />
                    @(Model.IdphuongThucThanhToanNavigation?.TenPhuongThuc ?? "N/A")
                </p>

                @if (Model.IdmaGiamGiaNavigation is not null)
                {
                    <p class="mb-0">
                        <strong>Mã giảm giá:</strong><br />
                        <span class="badge bg-success">@Model.IdmaGiamGiaNavigation.MaCode</span>
                    </p>
                }

                <hr />

                <p class="mb-0 text-muted small">
                    <strong>Ngày tạo:</strong><br />
                    @(Model.NgayTao.HasValue ? Model.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                </p>
            </div>
        </div>
    </div>
</div>