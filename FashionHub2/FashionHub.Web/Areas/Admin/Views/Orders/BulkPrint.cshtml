@model IEnumerable<FashionHub.Web.Models.Generated.DonHang>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>In hàng loạt - OWE Fashion</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 13px;
            line-height: 1.5;
            color: #333;
            padding: 15px;
            background: #fff;
        }

        .print-controls {
            text-align: center;
            margin-bottom: 20px;
            padding: 15px;
            background: #f0f0f0;
            border-radius: 5px;
        }

        .btn-print {
            background: #000;
            color: #fff;
            padding: 10px 25px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-radius: 4px;
        }

        .btn-print:hover {
            background: #333;
        }

        .invoice-page {
            max-width: 800px;
            margin: 0 auto 40px;
            background: #fff;
            padding: 30px;
            border: 1px solid #ddd;
            page-break-after: always;
        }

        .invoice-page:last-child {
            page-break-after: auto;
        }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 2px solid #000;
        }

        .company-info h1 {
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 5px;
            letter-spacing: 1.5px;
        }

        .company-info p {
            margin: 2px 0;
            color: #666;
            font-size: 12px;
        }

        .invoice-meta {
            text-align: right;
        }

        .invoice-meta h2 {
            font-size: 24px;
            margin-bottom: 8px;
            color: #000;
        }

        .invoice-meta p {
            margin: 3px 0;
            font-size: 12px;
        }

        .customer-info {
            margin-bottom: 20px;
            padding: 12px;
            background: #f9f9f9;
            border-left: 3px solid #000;
        }

        .customer-info h3 {
            margin-bottom: 8px;
            font-size: 14px;
            text-transform: uppercase;
            font-weight: 600;
        }

        .customer-info p {
            margin: 4px 0;
            font-size: 13px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        thead {
            background: #000;
            color: #fff;
        }

        th, td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
        }

        td {
            font-size: 13px;
        }

        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        .totals {
            margin-left: auto;
            width: 300px;
        }

        .totals tr td {
            padding: 6px 10px;
            border-bottom: none;
        }

        .totals tr:last-child {
            border-top: 2px solid #000;
        }

        .totals tr:last-child td {
            font-size: 16px;
            font-weight: bold;
            padding-top: 10px;
        }

        @@media print {
            .print-controls {
                display: none;
            }

            .invoice-page {
                border: none;
                padding: 20px;
                margin-bottom: 0;
            }

            body {
                padding: 0;
            }

            @@page {
                margin: 1.5cm;
            }
        }
    </style>
</head>
<body>
    <div class="print-controls">
        <button onclick="window.print()" class="btn-print">In tất cả (@Model.Count() đơn hàng)</button>
    </div>

    @foreach (var order in Model)
    {
        <div class="invoice-page">
            <div class="invoice-header">
                <div class="company-info">
                    <h1>OWE</h1>
                    <p>Fashion Store</p>
                    <p>Hotline: 1900 XXXX</p>
                </div>

                <div class="invoice-meta">
                    <h2>HÓA ĐƠN</h2>
                    <p><strong>Số:</strong> #@order.IddonHang</p>
                    <p><strong>Ngày:</strong> @(order.NgayTao.HasValue ? order.NgayTao.Value.ToString("dd/MM/yyyy") : "N/A")</p>
                </div>
            </div>

            <div class="customer-info">
                <h3>Thông tin khách hàng</h3>
                <p><strong>Họ tên:</strong> @order.TenNguoiNhan</p>
                <p><strong>SĐT:</strong> @order.SoDienThoai</p>
                <p><strong>Địa chỉ:</strong> @order.DiaChiGiao</p>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-center">SL</th>
                        <th class="text-right">Đơn giá</th>
                        <th class="text-right">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.ChiTietDonHangs)
                    {
                        <tr>
                            <td>
                                <strong>@item.TenSanPham</strong>
                                @if (!string.IsNullOrEmpty(item.TenMau) || !string.IsNullOrEmpty(item.TenKichThuoc))
                                {
                                    <br />
                                    <small style="color: #666;">
                                        @if (!string.IsNullOrEmpty(item.TenMau))
                                        {
                                            <span>@item.TenMau</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.TenKichThuoc))
                                        {
                                            <span> | @item.TenKichThuoc</span>
                                        }
                                    </small>
                                }
                            </td>
                            <td class="text-center">@item.SoLuong</td>
                            <td class="text-right">@item.DonGia.ToString("N0") đ</td>
                            <td class="text-right"><strong>@((item.SoLuong * item.DonGia).ToString("N0")) đ</strong></td>
                        </tr>
                    }
                </tbody>
            </table>

            <table class="totals">
                <tr>
                    <td>Tổng tiền hàng:</td>
                    <td class="text-right"><strong>@order.TongTienHang.ToString("N0") đ</strong></td>
                </tr>
                @if (order.PhiVanChuyen.HasValue && order.PhiVanChuyen.Value > 0)
                {
                    <tr>
                        <td>Phí vận chuyển:</td>
                        <td class="text-right"><strong>@order.PhiVanChuyen.Value.ToString("N0") đ</strong></td>
                    </tr>
                }
                @if (order.TienGiamGia.HasValue && order.TienGiamGia.Value > 0)
                {
                    <tr style="color: #28a745;">
                        <td>Giảm giá:</td>
                        <td class="text-right"><strong>-@order.TienGiamGia.Value.ToString("N0") đ</strong></td>
                    </tr>
                }
                <tr>
                    <td>TỔNG THANH TOÁN:</td>
                    <td class="text-right">@order.TongThanhToan.ToString("N0") đ</td>
                </tr>
            </table>
        </div>
    }
</body>
</html>