@model IEnumerable<FashionHub.Web.Models.Generated.DonHang>

@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var statusList = ViewBag.StatusList as IEnumerable<FashionHub.Web.Models.Generated.TrangThaiDonHang> ?? Enumerable.Empty<FashionHub.Web.Models.Generated.TrangThaiDonHang>();
    var selectedStatusId = ViewBag.StatusId as int?;
    var searchString = ViewBag.SearchString as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
    var pendingCount = Model.Count(order => order.IdtrangThai == 0);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-uppercase">Quản lý Đơn hàng</h4>
    <div>
        <a asp-action="ExportExcel" class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet"></i> Xuất Excel
        </a>
    </div>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light rounded">
        <form asp-action="Index" asp-controller="Orders" asp-area="Admin" method="get" class="row g-2">
            <div class="col-md-3">
                <label for="searchString" class="visually-hidden">Mã đơn hoặc tên khách</label>
                <input type="text" id="searchString" name="searchString" class="form-control" placeholder="Mã đơn / Tên khách..." value="@searchString" />
            </div>
            <div class="col-md-2">
                <label for="statusId" class="visually-hidden">Trạng thái</label>
                <select id="statusId" name="statusId" class="form-select">
                    <option value="">-- Trạng thái --</option>
                    @foreach (var status in statusList)
                    {
                        <option value="@status.IdtrangThai" selected="@(selectedStatusId == status.IdtrangThai)">
                            @status.TenTrangThai
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="fromDate" class="visually-hidden">Từ ngày</label>
                <input type="date" id="fromDate" name="fromDate" class="form-control" value="@fromDate" title="Từ ngày" />
            </div>
            <div class="col-md-2">
                <label for="toDate" class="visually-hidden">Đến ngày</label>
                <input type="date" id="toDate" name="toDate" class="form-control" value="@toDate" title="Đến ngày" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-filter"></i> Lọc đơn hàng
                </button>
            </div>
        </form>
    </div>
</div>

<form asp-action="BulkPrint" asp-controller="Orders" asp-area="Admin" method="post" id="bulkForm" target="_blank">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm">
        <div class="card-header bg-white py-2 d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="selectAll" />
                <label class="form-check-label fw-bold" for="selectAll">Chọn tất cả</label>
            </div>
            <div>
                <button type="submit" class="btn btn-sm btn-secondary">
                    <i class="bi bi-printer"></i> In các đơn đã chọn
                </button>

                @if (pendingCount > 0)
                {
                    <button type="button" class="btn btn-sm btn-success text-white ms-2" id="btn-confirm-all">
                        <i class="bi bi-check-all"></i> Xác nhận tất cả (@pendingCount)
                    </button>
                }
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 40px;">Chọn</th>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Không có đơn hàng phù hợp.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input class="form-check-input item-checkbox" type="checkbox" name="selectedIds" value="@item.IddonHang" aria-label="Chọn đơn hàng #@item.IddonHang" />
                                    </td>
                                    <td class="fw-bold">#@item.IddonHang</td>
                                    <td>
                                        <div class="fw-bold">@item.TenNguoiNhan</div>
                                        <small class="text-muted">@item.SoDienThoai</small>
                                    </td>
                                    <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold text-primary">@item.TongThanhToan.ToString("N0") đ</td>
                                    <td>
                                        @switch (item.IdtrangThai)
                                        {
                                            case 0:
                                                <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                                break;
                                            case 1:
                                                <span class="badge bg-info">Đã xác nhận</span>
                                                break;
                                            case 2:
                                                <span class="badge bg-primary">Đang giao</span>
                                                break;
                                            case 3:
                                                <span class="badge bg-success">Hoàn thành</span>
                                                break;
                                            default:
                                                <span class="badge bg-danger">Đã hủy</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.IdtrangThai == 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success btn-confirm-single me-1" data-id="@item.IddonHang" title="Xác nhận đơn này" aria-label="Xác nhận đơn hàng #@item.IddonHang">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        }

                                        <a asp-action="Details" asp-route-id="@item.IddonHang" class="btn btn-sm btn-outline-primary" title="Xem chi tiết" aria-label="Xem chi tiết đơn hàng #@item.IddonHang">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            function postJson(url, data) {
                const formData = new URLSearchParams();

                if (token) {
                    formData.append('__RequestVerificationToken', token);
                }

                Object.keys(data || {}).forEach(function (key) {
                    formData.append(key, data[key]);
                });

                return fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: formData.toString()
                }).then(function (response) {
                    return response.json();
                });
            }

            document.querySelectorAll('.btn-confirm-single').forEach(function (button) {
                button.addEventListener('click', function () {
                    const id = button.dataset.id;

                    if (!window.confirm('Xác nhận đơn hàng #' + id + '?')) {
                        return;
                    }

                    postJson('@Url.Action("ConfirmOrder", "Orders", new { area = "Admin" })', { id: id })
                        .then(function (res) {
                            if (res.success) {
                                window.location.reload();
                                return;
                            }

                            window.alert(res.message);
                        });
                });
            });

            const confirmAllButton = document.getElementById('btn-confirm-all');
            if (confirmAllButton) {
                confirmAllButton.addEventListener('click', function () {
                    if (!window.confirm('Bạn có chắc muốn xác nhận TOÀN BỘ đơn hàng đang chờ không?')) {
                        return;
                    }

                    confirmAllButton.disabled = true;
                    confirmAllButton.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xử lý...';

                    postJson('@Url.Action("ConfirmAllPending", "Orders", new { area = "Admin" })', {})
                        .then(function (res) {
                            window.alert(res.message);

                            if (res.success) {
                                window.location.reload();
                                return;
                            }

                            confirmAllButton.disabled = false;
                            confirmAllButton.innerHTML = '<i class="bi bi-check-all"></i> Xác nhận tất cả';
                        });
                });
            }

            const selectAll = document.getElementById('selectAll');
            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    document.querySelectorAll('.item-checkbox').forEach(function (checkbox) {
                        checkbox.checked = selectAll.checked;
                    });
                });
            }
        })();
    </script>
}
