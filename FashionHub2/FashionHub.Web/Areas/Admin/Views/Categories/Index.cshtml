@model FashionHub.Web.Areas.Admin.ViewModels.CategoryListViewModel
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Quản lý danh mục</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Thêm danh mục
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <!-- Search Form -->
        <form asp-action="Index" method="get" class="mb-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" 
                               class="form-control" placeholder="Tìm kiếm danh mục...">
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>
                        </button>
                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </form>

        @if (Model.Categories.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tên danh mục</th>
                            <th>Danh mục cha</th>
                            <th class="text-center">Số sản phẩm</th>
                            <th class="text-center">Danh mục con</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td class="fw-medium">@category.Name</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(category.ParentCategoryName))
                                    {
                                        <span class="badge bg-secondary">@category.ParentCategoryName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (category.ProductCount > 0)
                                    {
                                        <span class="badge bg-info">@category.ProductCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (category.SubCategories.Any())
                                    {
                                        <span class="badge bg-primary">@category.SubCategories.Count</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@category.Id" 
                                           class="btn btn-outline-primary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@category.Id" 
                                           class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            @* Show subcategories *@
                            @if (category.SubCategories.Any())
                            {
                                @foreach (var subCategory in category.SubCategories)
                                {
                                    <tr class="table-light">
                                        <td class="ps-5">
                                            <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                            @subCategory.Name
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@category.Name</span>
                                        </td>
                                        <td class="text-center">
                                            @if (subCategory.ProductCount > 0)
                                            {
                                                <span class="badge bg-info">@subCategory.ProductCount</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="text-muted">—</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Edit" asp-route-id="@subCategory.Id" 
                                                   class="btn btn-outline-primary" title="Chỉnh sửa">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@subCategory.Id" 
                                                   class="btn btn-outline-danger" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-folder-x fs-1"></i>
                <p class="mt-3">
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <text>Không tìm thấy danh mục nào phù hợp</text>
                    }
                    else
                    {
                        <text>Chưa có danh mục nào</text>
                    }
                </p>
                @if (string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-action="Create" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Thêm danh mục đầu tiên
                    </a>
                }
            </div>
        }
    </div>
</div>