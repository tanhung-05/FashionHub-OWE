@model CustomerReportViewModel
@{
    ViewData["Title"] = "Báo cáo khách hàng";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="h4 mb-1">Báo cáo khách hàng</h2>
        <p class="text-muted mb-0">Theo dõi khách hàng mới và mức độ hoạt động trong kỳ.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Quay lại
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="CustomerReport" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="customerStartDate" class="form-label">Từ ngày</label>
                <input id="customerStartDate" type="date" name="startDate" class="form-control"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-5">
                <label for="customerEndDate" class="form-label">Đến ngày</label>
                <input id="customerEndDate" type="date" name="endDate" class="form-control"
                       value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-funnel me-1" aria-hidden="true"></i>Lọc
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Tổng khách hàng</div>
                <div class="fs-3 fw-bold">@Model.TotalCustomers.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Khách hàng mới trong kỳ</div>
                <div class="fs-3 fw-bold text-success">@Model.NewCustomers.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Khách hàng có đơn</div>
                <div class="fs-3 fw-bold text-primary">@Model.ActiveCustomers.ToString("N0")</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white py-3">
        <h3 class="h6 mb-0">Top khách hàng theo chi tiêu</h3>
    </div>
    @if (Model.TopCustomers.Count == 0)
    {
        <div class="admin-empty-state">
            <i class="bi bi-people" aria-hidden="true"></i>
            Không có dữ liệu khách hàng trong khoảng thời gian đã chọn.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Khách hàng</th>
                        <th>Email</th>
                        <th class="text-end">Số đơn</th>
                        <th class="text-end">Tổng chi tiêu</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Model.TopCustomers.Count; index++)
                    {
                        var customer = Model.TopCustomers[index];
                        <tr>
                            <td>@(index + 1)</td>
                            <td class="fw-semibold">@customer.CustomerName</td>
                            <td>@customer.Email</td>
                            <td class="text-end">@customer.TotalOrders.ToString("N0")</td>
                            <td class="text-end fw-bold">@customer.TotalSpent.ToString("N0") đ</td>
                            <td class="text-end">
                                <a asp-controller="Users" asp-action="Details"
                                   asp-route-id="@customer.CustomerId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1" aria-hidden="true"></i>Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
