@model List<FashionHub.Web.ViewModels.Cart.CartItemViewModel>

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container my-5">
    <h2 class="text-center mb-4">Giỏ hàng của bạn</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-lg-8">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col" colspan="2">Sản phẩm</th>
                            <th scope="col">Đơn giá</th>
                            <th scope="col" class="text-center">Số lượng</th>
                            <th scope="col" class="text-end">Tạm tính</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr id="row-@item.IdbienThe">
                                <td style="width: 100px;">
                                    <img src="@item.AnhDaiDien" class="img-fluid" alt="@item.TenSanPham">
                                </td>
                                <td>
                                    <p class="mb-0 fw-bold">@item.TenSanPham</p>
                                    <small class="text-muted">@item.TenMau / @item.TenKichThuoc</small>
                                </td>
                                <td>@item.DonGia.ToString("N0") VNĐ</td>
                                <td>
                                    <div class="input-group justify-content-center" style="width: 120px;">
                                        <button class="btn btn-outline-secondary btn-sm btn-minus" data-id="@item.IdbienThe" type="button" aria-label="Giảm số lượng">-</button>
                                        <input type="number" class="form-control form-control-sm text-center quantity-input" value="@item.SoLuong" min="1" data-id="@item.IdbienThe" aria-label="Số lượng @item.TenSanPham">
                                        <button class="btn btn-outline-secondary btn-sm btn-plus" data-id="@item.IdbienThe" type="button" aria-label="Tăng số lượng">+</button>
                                    </div>
                                </td>
                                <td class="text-end fw-bold" id="item-total-@item.IdbienThe">@item.ThanhTien.ToString("N0") VNĐ</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger btn-remove" data-id="@item.IdbienThe" type="button" aria-label="Xóa @item.TenSanPham khỏi giỏ hàng">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Tổng cộng</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Tạm tính</span>
                                <span id="cart-subtotal">@Model.Sum(item => item.ThanhTien).ToString("N0") VNĐ</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Giảm giá</span>
                                <span>0 VNĐ</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between fw-bold">
                                <span>Tổng tiền</span>
                                <span id="cart-total">@Model.Sum(item => item.ThanhTien).ToString("N0") VNĐ</span>
                            </li>
                        </ul>
                        <div class="d-grid mt-3">
                            <a asp-controller="Order"
                               asp-action="Checkout"
                               asp-route-cartType="Normal"
                               class="btn btn-dark">
                                Tiến hành thanh toán
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <p>Giỏ hàng của bạn đang trống.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-dark">Tiếp tục mua sắm</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function updateCartSummary(cartTotal, cartCount) {
                $('#cart-subtotal').text(cartTotal + ' VNĐ');
                $('#cart-total').text(cartTotal + ' VNĐ');
                $('#cart-count').text(cartCount);
            }

            $('.btn-plus, .btn-minus').on('click', function () {
                const variantId = $(this).data('id');
                const input = $(`.quantity-input[data-id=${variantId}]`);
                let quantity = parseInt(input.val());

                if ($(this).hasClass('btn-plus')) {
                    quantity++;
                } else if (quantity > 1) {
                    quantity--;
                }

                input.val(quantity);
                updateQuantity(variantId, quantity);
            });

            $('.quantity-input').on('change', function () {
                const variantId = $(this).data('id');
                let quantity = parseInt($(this).val());

                if (isNaN(quantity) || quantity < 1) {
                    quantity = 1;
                    $(this).val(1);
                }

                updateQuantity(variantId, quantity);
            });

            function updateQuantity(variantId, quantity) {
                $.ajax({
                    url: '@Url.Action("UpdateCart", "Cart")',
                    type: 'POST',
                    data: { variantId: variantId, quantity: quantity },
                    success: function (response) {
                        if (response.success) {
                            $('#item-total-' + variantId).text(response.itemTotal + ' VNĐ');
                            updateCartSummary(response.cartTotal, response.cartCount);
                        } else {
                            window.alert(response.message || 'Không thể cập nhật giỏ hàng.');
                        }
                    },
                    error: function () {
                        window.alert('Đã xảy ra lỗi khi cập nhật giỏ hàng.');
                    }
                });
            }

            $('.btn-remove').on('click', function () {
                if (!window.confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')) {
                    return;
                }

                const variantId = $(this).data('id');

                $.ajax({
                    url: '@Url.Action("RemoveFromCart", "Cart")',
                    type: 'POST',
                    data: { variantId: variantId },
                    success: function (response) {
                        if (response.success) {
                            $('#row-' + variantId).fadeOut(300, function () { $(this).remove(); });
                            updateCartSummary(response.cartTotal, response.cartCount);

                            if (response.cartCount === 0) {
                                location.reload();
                            }
                        } else {
                            window.alert(response.message || 'Không thể xóa sản phẩm.');
                        }
                    },
                    error: function () {
                        window.alert('Đã xảy ra lỗi khi xóa sản phẩm.');
                    }
                });
            });
        });
    </script>
}
