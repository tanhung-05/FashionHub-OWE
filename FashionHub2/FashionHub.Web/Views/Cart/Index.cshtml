@model List<FashionHub.Web.ViewModels.Cart.CartItemViewModel>
@{
    ViewData["Title"] = "Giỏ hàng";
    ViewData["MetaDescription"] = "Kiểm tra sản phẩm, biến thể và số lượng trong giỏ hàng OWE.";
}

<div class="cart-page">
    <header class="cart-page-heading">
        <div>
            <p class="section-kicker">YOUR SELECTION</p>
            <h1>Giỏ hàng</h1>
        </div>
        @if (Model.Any())
        {
            <p><strong id="cart-page-count">@Model.Sum(item => item.SoLuong)</strong> sản phẩm</p>
        }
    </header>

    @if (Model.Any())
    {
        <div class="cart-layout">
            <section class="cart-items-panel" aria-labelledby="cart-items-title">
                <h2 id="cart-items-title" class="visually-hidden">Sản phẩm trong giỏ</h2>
                @foreach (var item in Model)
                {
                    <article class="cart-line-item" id="row-@item.IdbienThe"
                             data-variant-id="@item.IdbienThe">
                        <a class="cart-line-image" asp-controller="Products" asp-action="Details"
                           asp-route-id="@item.IdsanPham" aria-label="Xem @item.TenSanPham">
                            <img src="@item.AnhDaiDien" alt="@item.TenSanPham" />
                        </a>
                        <div class="cart-line-main">
                            <div class="cart-line-heading">
                                <div>
                                    <h2>
                                        <a asp-controller="Products" asp-action="Details"
                                           asp-route-id="@item.IdsanPham">@item.TenSanPham</a>
                                    </h2>
                                    <p>@item.TenMau <span aria-hidden="true">/</span> @item.TenKichThuoc</p>
                                </div>
                                <strong>@item.DonGia.ToString("N0") ₫</strong>
                            </div>
                            <div class="cart-line-controls">
                                <div class="cart-quantity-control" aria-label="Số lượng @item.TenSanPham">
                                    <button type="button" class="js-cart-decrease"
                                            data-id="@item.IdbienThe" aria-label="Giảm số lượng">
                                        <i class="bi bi-dash" aria-hidden="true"></i>
                                    </button>
                                    <input type="number" class="quantity-input"
                                           value="@item.SoLuong" min="1" max="@item.SoLuongTon"
                                           data-id="@item.IdbienThe" inputmode="numeric"
                                           aria-label="Số lượng @item.TenSanPham" />
                                    <button type="button" class="js-cart-increase"
                                            data-id="@item.IdbienThe" aria-label="Tăng số lượng">
                                        <i class="bi bi-plus" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <span class="cart-stock-note">Còn @item.SoLuongTon sản phẩm</span>
                                <button type="button" class="cart-remove-button js-cart-remove"
                                        data-id="@item.IdbienThe">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                    Xóa
                                </button>
                            </div>
                        </div>
                        <strong class="cart-line-total" id="item-total-@item.IdbienThe">
                            @item.ThanhTien.ToString("N0") ₫
                        </strong>
                    </article>
                }
            </section>

            <aside class="cart-summary" aria-labelledby="cart-summary-title">
                <p class="section-kicker">ORDER SUMMARY</p>
                <h2 id="cart-summary-title">Tóm tắt đơn hàng</h2>
                <dl>
                    <div>
                        <dt>Tạm tính</dt>
                        <dd id="cart-subtotal">@Model.Sum(item => item.ThanhTien).ToString("N0") ₫</dd>
                    </div>
                    <div>
                        <dt>Phí vận chuyển</dt>
                        <dd>Tính ở bước sau</dd>
                    </div>
                    <div class="cart-summary-total">
                        <dt>Tổng dự kiến</dt>
                        <dd id="cart-total">@Model.Sum(item => item.ThanhTien).ToString("N0") ₫</dd>
                    </div>
                </dl>
                <a asp-controller="Order" asp-action="Checkout" asp-route-cartType="Normal"
                   class="btn btn-dark w-100">
                    Tiến hành thanh toán
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
                <a asp-controller="Products" asp-action="Index" class="cart-continue-link">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Tiếp tục mua sắm
                </a>
                <p class="cart-summary-note">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    Giá và tồn kho sẽ được kiểm tra lại khi đặt hàng.
                </p>
            </aside>
        </div>
    }
    else
    {
        <div class="cart-empty-state">
            <span><i class="bi bi-bag" aria-hidden="true"></i></span>
            <p class="section-kicker">YOUR BAG IS EMPTY</p>
            <h2>Giỏ hàng đang trống</h2>
            <p>Khám phá bộ sưu tập mới và chọn món đồ phù hợp với bạn.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-dark">Bắt đầu mua sắm</a>
        </div>
    }
</div>
