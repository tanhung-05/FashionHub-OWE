@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant() ?? "home";
    var actionName = ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant() ?? "index";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "OWE - thời trang nam hiện đại, dễ mặc mỗi ngày.")" />
    <meta name="theme-color" content="#ffffff" />
    <title>@ViewData["Title"] - OWE</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="page-@controllerName page-@controllerName-@actionName">
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
    <partial name="_GlobalFeedbackPartial" />
    <partial name="_HeaderPartial" />

    <div class="header-spacer" aria-hidden="true"></div>
    <partial name="_BreadcrumbPartial" />

    <main id="main-content" role="main" class="container site-main">
        @RenderBody()
    </main>

    <partial name="_QuickViewModalPartial" />
    <partial name="_CartOffcanvasPartial" />
    <partial name="_FooterPartial" />
    <partial name="_ChatWidgetPartial" />

    <form id="global-antiforgery-form" class="d-none" aria-hidden="true">
        @Html.AntiForgeryToken()
    </form>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/vietnam-address-selector.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
