@model IEnumerable<FashionHub.Web.Models.Generated.DanhMuc>

@{
    var parentCategories = Model.Where(c => c.IddanhMucCha == null).ToList();

    // Lấy Controller và Action hiện tại
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Hàm helper kiểm tra nếu link hiện tại là active
    Func<string, string, string> isActive = (controller, action) =>
    {
        return (currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) && 
                currentAction.Equals(action, StringComparison.OrdinalIgnoreCase)) 
            ? "active" 
            : "";
    };
}

<li class="nav-item">
    <a class="nav-link @isActive("Home", "Index")" aria-current="page" asp-controller="Home" asp-action="Index">Trang chủ</a>
</li>

<li class="nav-item dropdown nav-products">
    <div class="nav-products-trigger">
        <a class="nav-link @isActive("Products", "Index")"
           asp-controller="Products" asp-action="Index">Sản phẩm</a>
        <button type="button" class="nav-category-toggle dropdown-toggle hide-arrow"
                id="categoryDropdown" data-bs-toggle="dropdown" aria-expanded="false"
                aria-label="Mở danh mục sản phẩm">
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </button>
    </div>
    <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
        <li>
            <a class="dropdown-item" asp-controller="Products" asp-action="Index">
                Tất cả sản phẩm
            </a>
        </li>
        @foreach (var parent in parentCategories)
        {
            var childCategories = Model.Where(c => c.IddanhMucCha == parent.IddanhMuc).ToList();

            if (childCategories.Any())
            {
                <li class="dropdown-submenu">
                    <a class="dropdown-item d-flex justify-content-between align-items-center"
                       asp-controller="Products" asp-action="Index" asp-route-categoryId="@parent.IddanhMuc">
                        <span>@parent.TenDanhMuc</span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <ul class="dropdown-menu">
                        @foreach (var child in childCategories)
                        {
                            <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-categoryId="@child.IddanhMuc">@child.TenDanhMuc</a></li>
                        }
                    </ul>
                </li>
            }
            else
            {
                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-categoryId="@parent.IddanhMuc">@parent.TenDanhMuc</a></li>
            }
        }
    </ul>
</li>

<li class="nav-item">
    <a class="nav-link @isActive("Blog", "Index")"
       asp-controller="Blog" asp-action="Index">Blog</a>
</li>

<li class="nav-item">
    <a class="nav-link @isActive("Contact", "Index")"
       asp-controller="Contact" asp-action="Index">Liên hệ</a>
</li>
