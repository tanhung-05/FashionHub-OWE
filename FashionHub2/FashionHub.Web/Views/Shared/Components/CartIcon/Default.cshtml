<button type="button" class="header-icon-button header-cart-button"
        data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas"
        aria-controls="cartOffcanvas" aria-label="Mở giỏ hàng, @ViewBag.CartItemCount sản phẩm">
    <i class="bi bi-bag" aria-hidden="true"></i>
    <span id="cart-count" class="cart-count-badge" aria-live="polite">@ViewBag.CartItemCount</span>
</button>
