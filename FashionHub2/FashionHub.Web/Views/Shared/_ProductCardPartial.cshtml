@model FashionHub.Web.ViewModels.Products.ProductCardViewModel
@{
    var imageUrl = string.IsNullOrWhiteSpace(Model.AnhChinhURL)
        ? "/images/products/aothun1_den_boxy.jpg"
        : Model.AnhChinhURL;
}

<article class="product-card">
    <div class="product-card-media">
        @if (Model.IsOutStock)
        {
            <span class="product-card-badge sold-out">Hết hàng</span>
        }
        else if (Model.IsSaleActive && Model.Gia.HasValue && Model.Gia.Value > 0)
        {
            <span class="product-card-badge sale">
                -@Math.Round((1 - (Model.GiaKhuyenMai!.Value / Model.Gia.Value)) * 100)%
            </span>
        }

        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.IDSanPham"
           aria-label="Xem @Model.TenSanPham">
            <img src="@imageUrl" class="product-img" alt="@Model.TenSanPham" loading="lazy" />
        </a>

        <div class="product-card-actions">
            <button class="btn btn-light quick-view-btn"
                    type="button"
                    data-product-id="@Model.IDSanPham"
                    data-action-type="add-to-cart"
                    disabled="@Model.IsOutStock"
                    aria-label="Chọn biến thể và thêm @Model.TenSanPham vào giỏ">
                <i class="bi bi-bag-plus" aria-hidden="true"></i>
                <span>Thêm giỏ</span>
            </button>
            <a class="btn btn-dark"
               asp-controller="Products" asp-action="Details" asp-route-id="@Model.IDSanPham">
                Xem chi tiết
            </a>
        </div>
    </div>

    <div class="product-card-body">
        <h3>
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.IDSanPham">
                @Model.TenSanPham
            </a>
        </h3>
        <div class="product-card-price">
            @if (Model.IsSaleActive)
            {
                <strong>@Model.GiaKhuyenMai!.Value.ToString("N0") ₫</strong>
                <del>@Model.Gia!.Value.ToString("N0") ₫</del>
            }
            else
            {
                <strong>@(Model.Gia.HasValue ? $"{Model.Gia.Value:N0} ₫" : "Liên hệ")</strong>
            }
        </div>
    </div>
</article>
