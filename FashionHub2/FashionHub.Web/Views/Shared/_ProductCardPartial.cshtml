@model FashionHub.Web.ViewModels.Products.ProductCardViewModel

<div class="card h-100 shadow-sm product-card">
    <div class="position-relative">

        @if (Model.IsOutStock)
        {
            <div class="position-absolute top-0 start-0 bg-secondary text-white px-2 py-1 m-2 small fw-bold"
                 style="z-index: 10; opacity: 0.8; font-size: 0.75rem;">
                HẾT HÀNG
            </div>
        }
        else if (Model.GiaKhuyenMai.HasValue && Model.Gia.HasValue && Model.Gia.Value > 0 && Model.GiaKhuyenMai < Model.Gia)
        {
            <div class="position-absolute top-0 end-0 bg-danger text-white px-2 py-1 m-2 small fw-bold rounded"
                 style="z-index: 10; font-size: 0.75rem;">
                SALE -@Math.Round((1 - (Model.GiaKhuyenMai.Value / Model.Gia.Value)) * 100)%
            </div>
        }

        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.IDSanPham">
            <img src="@(string.IsNullOrEmpty(Model.AnhChinhURL) ? "/images/placeholder.png" : Model.AnhChinhURL)" class="card-img-top product-img" alt="@Model.TenSanPham">
        </a>
    </div>

    <div class="card-body d-flex flex-column">
        <h5 class="card-title flex-grow-1">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.IDSanPham" class="text-decoration-none text-dark stretched-link">
                @Model.TenSanPham
            </a>
        </h5>

        <div class="card-text">
            @if (Model.GiaKhuyenMai.HasValue && Model.Gia.HasValue && Model.GiaKhuyenMai < Model.Gia)
            {
                <span class="fw-bold text-danger fs-5">@Model.GiaKhuyenMai.Value.ToString("N0")₫</span>
                <span class="text-muted text-decoration-line-through ms-2 small">@Model.Gia.Value.ToString("N0")₫</span>
            }
            else
            {
                <span class="fw-bold text-danger fs-5">
                    @(Model.Gia.HasValue ? Model.Gia.Value.ToString("N0") + "₫" : "Liên hệ")
                </span>
            }
        </div>
    </div>

    <div class="card-footer position-relative" style="z-index: 10;">
        <div class="action-buttons">
            <button class="btn btn-outline-dark quick-view-btn"
                    data-product-id="@Model.IDSanPham"
                    data-action-type="add-to-cart"
                    @(Model.IsOutStock ? "disabled" : "")>
                <i class="bi bi-cart-plus"></i> Thêm giỏ
            </button>

            <button class="btn btn-dark quick-view-btn"
                    data-product-id="@Model.IDSanPham"
                    data-action-type="buy-now"
                    @(Model.IsOutStock ? "disabled" : "")>
                <i class="bi bi-lightning-fill"></i> Mua ngay
            </button>
        </div>
    </div>
</div>

<style>
    .product-card:hover .product-img {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }

    .product-card:hover .product-action {
        transform: translateY(0) !important;
    }

    .product-card:has(.bg-secondary) .product-img {
        opacity: 0.6;
    }
</style>