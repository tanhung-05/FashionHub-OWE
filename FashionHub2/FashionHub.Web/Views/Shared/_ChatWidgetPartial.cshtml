<button id="chat-toggle-btn" class="btn btn-primary rounded-circle shadow-lg chat-toggle-btn" aria-label="Mở chat">
    <i class="bi bi-chat-dots-fill fs-3"></i>
</button>

<div id="chat-box" class="card shadow-lg d-none chat-box">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center chat-box-header">
        <h6 class="mb-0"><i class="bi bi-robot me-2"></i>Trợ lý FashionHub</h6>
        <button type="button" class="btn-close btn-close-white" id="chat-close-btn" aria-label="Đóng chat"></button>
    </div>

    <div class="card-body overflow-auto d-flex flex-column" id="chat-content">
        <div class="d-flex flex-row justify-content-start mb-3">
            <div class="p-3 bg-white border rounded-3 shadow-sm chat-message">
                Xin chào! Tôi là trợ lý ảo OWE. Bạn cần giúp gì không?
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-3" id="quick-replies">
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill quick-reply-btn">Săn mã giảm giá</button>
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill quick-reply-btn">Tìm áo thun</button>
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill quick-reply-btn">Phí ship thế nào?</button>
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill quick-reply-btn">Tư vấn size 60kg</button>
        </div>
    </div>

    <div class="card-footer bg-white border-top">
        <div class="input-group">
            <input type="text" id="chat-input" class="form-control border-0" placeholder="Nhập tin nhắn..." autocomplete="off">
            <button class="btn btn-link text-primary" id="chat-send-btn" type="button" aria-label="Gửi tin nhắn">
                <i class="bi bi-send-fill fs-5"></i>
            </button>
        </div>
    </div>
</div>