@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<header class="main-navbar fixed-top" id="mainHeader">
    <nav class="navbar navbar-expand-lg" aria-label="Điều hướng chính">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="OWE - Trang chủ">
                OWE
            </a>

            <div class="header-mobile-actions">
                <button type="button" class="header-icon-button"
                        data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas"
                        aria-controls="cartOffcanvas" aria-label="Mở giỏ hàng">
                    <i class="bi bi-bag" aria-hidden="true"></i>
                </button>
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar"
                        aria-controls="offcanvasNavbar" aria-label="Mở menu">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
            </div>

            <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar"
                 aria-labelledby="offcanvasNavbarLabel">
                <div class="offcanvas-header">
                    <h2 class="offcanvas-title" id="offcanvasNavbarLabel">OWE Menu</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"
                            aria-label="Đóng menu"></button>
                </div>

                <div class="offcanvas-body">
                    <ul class="navbar-nav mx-auto">
                        @await Component.InvokeAsync("Menu")
                    </ul>

                    <div class="mobile-menu-account d-lg-none">
                        @if (isAuthenticated)
                        {
                            <div class="mobile-account-summary">
                                <span class="mobile-account-avatar" aria-hidden="true">
                                    <i class="bi bi-person"></i>
                                </span>
                                <span>
                                    <strong>@User.FindFirstValue(ClaimTypes.Name)</strong>
                                    <small>@User.FindFirstValue(ClaimTypes.Email)</small>
                                </span>
                            </div>
                            <nav class="mobile-account-links" aria-label="Tài khoản">
                                <a asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-vcard" aria-hidden="true"></i>Hồ sơ
                                </a>
                                <a asp-controller="Account" asp-action="Addresses">
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i>Địa chỉ
                                </a>
                                <a asp-controller="Account" asp-action="OrderHistory">
                                    <i class="bi bi-bag-check" aria-hidden="true"></i>Đơn hàng của tôi
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2" aria-hidden="true"></i>Trang quản trị
                                    </a>
                                }
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit">
                                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>Đăng xuất
                                    </button>
                                </form>
                            </nav>
                        }
                        else
                        {
                            <p class="mobile-account-label">Tài khoản</p>
                            <div class="mobile-auth-actions">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-dark">Đăng nhập</a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark">Đăng ký</a>
                            </div>
                        }
                    </div>

                    <div class="header-tools">
                        <form asp-controller="Products" asp-action="Index" method="get"
                              class="header-search" role="search">
                            <label for="main-search-input" class="visually-hidden">Tìm kiếm sản phẩm</label>
                            <input type="search" id="main-search-input" name="searchString"
                                   placeholder="Tìm sản phẩm"
                                   value="@Context.Request.Query["searchString"]"
                                   autocomplete="off" />
                            <button type="submit" aria-label="Tìm kiếm">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </button>
                        </form>

                        <div class="header-account-desktop">
                            @if (isAuthenticated)
                            {
                                <div class="dropdown">
                                <button type="button" class="header-icon-button dropdown-toggle hide-arrow"
                                        id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="Mở menu tài khoản">
                                    <i class="bi bi-person" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li class="header-account-summary">
                                        <strong>@User.FindFirstValue(ClaimTypes.Name)</strong>
                                        <span>@User.FindFirstValue(ClaimTypes.Email)</span>
                                    </li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-vcard"></i>Hồ sơ</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Addresses"><i class="bi bi-geo-alt"></i>Địa chỉ</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="OrderHistory"><i class="bi bi-bag-check"></i>Đơn hàng</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Quản trị</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button class="dropdown-item text-danger" type="submit">
                                                <i class="bi bi-box-arrow-right"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="header-login-link">
                                    Đăng nhập
                                </a>
                            }
                        </div>

                        <div class="header-cart-desktop">
                            @await Component.InvokeAsync("CartIcon")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>
