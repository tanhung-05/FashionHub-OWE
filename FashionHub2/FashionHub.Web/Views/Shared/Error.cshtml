@model ErrorViewModel
@{
    ViewData["Title"] = "Không thể xử lý yêu cầu";
}

<div class="account-empty-state">
    <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
    <h1>Đã có lỗi xảy ra</h1>
    <p>OWE chưa thể xử lý yêu cầu này. Vui lòng quay lại hoặc thử lại sau.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Về trang chủ</a>
    @if (Model.ShowRequestId)
    {
        <small class="mt-3 text-muted">Mã tra cứu: <code>@Model.RequestId</code></small>
    }
</div>
