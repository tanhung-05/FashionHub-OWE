<div class="offcanvas offcanvas-end cart-offcanvas" tabindex="-1" id="cartOffcanvas" aria-labelledby="cartOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
        <div>
            <p class="cart-offcanvas-eyebrow mb-1">OWE</p>
            <h5 class="offcanvas-title mb-0" id="cartOffcanvasLabel">Giỏ hàng của bạn</h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng giỏ hàng"></button>
    </div>
    <div class="offcanvas-body" id="cartOffcanvasBody" aria-live="polite">
        <div class="cart-offcanvas-loading">
            <div class="spinner-border spinner-border-sm" role="status">
                <span class="visually-hidden">Đang tải giỏ hàng</span>
            </div>
            <span>Đang cập nhật giỏ hàng...</span>
        </div>
    </div>
</div>
