@model FashionHub.Web.ViewModels.Order.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
    ViewData["MetaDescription"] = "Xác nhận địa chỉ, phương thức thanh toán và đơn hàng OWE.";
    var newAddressModel = new FashionHub.Web.ViewModels.Account.AddressManagementViewModel();
}

<div class="checkout-page">
    <header class="checkout-heading">
        <div>
            <p class="section-kicker">SECURE CHECKOUT</p>
            <h1>Thanh toán</h1>
        </div>
        <a asp-controller="Cart" asp-action="Index">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Quay lại giỏ hàng
        </a>
    </header>

    @{
        var checkoutError = TempData["Error"] as string
            ?? ViewData["CheckoutError"] as string;
    }
    @if (!string.IsNullOrWhiteSpace(checkoutError))
    {
        <div class="alert alert-danger checkout-alert" role="alert">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            @if (checkoutError == "Vui lòng chọn hoặc thêm địa chỉ giao hàng trước khi đặt hàng.")
            {
                <span>Vui lòng chọn hoặc thêm địa chỉ giao hàng trước khi đặt hàng.</span>
            }
            else if (checkoutError == "Vui lòng chọn phương thức thanh toán.")
            {
                <span>Vui lòng chọn phương thức thanh toán.</span>
            }
            else
            {
                <span>@checkoutError</span>
            }
        </div>
    }

    <div id="checkout-validation-summary" class="alert alert-danger d-none checkout-alert"
         role="alert" aria-live="assertive"></div>

    <form asp-action="PlaceOrder" asp-controller="Order" method="post" id="checkout-form">
        <input type="hidden" name="cartType" value="@ViewBag.CartType" />
        <div class="checkout-layout">
            <div class="checkout-sections">
                <section class="checkout-section" aria-labelledby="shipping-address-title">
                    <div class="checkout-section-heading">
                        <span>01</span>
                        <div>
                            <h2 id="shipping-address-title">Địa chỉ giao hàng</h2>
                            <p>Chọn địa chỉ chính xác để đơn hàng đến đúng nơi.</p>
                        </div>
                    </div>

                    <div class="checkout-address-list" id="address-list-container">
                        @if (Model.UserAddresses.Any())
                        {
                            @foreach (var address in Model.UserAddresses)
                            {
                                <label class="checkout-choice-card">
                                    <input type="radio" name="addressId" value="@address.IddiaChi"
                                           required checked="@address.LaMacDinh" />
                                    <span class="checkout-choice-indicator" aria-hidden="true"></span>
                                    <span>
                                        <strong>@address.TenNguoiNhan</strong>
                                        <small>@address.SoDienThoai</small>
                                        <em>@address.FullAddress</em>
                                    </span>
                                    @if (address.LaMacDinh)
                                    {
                                        <b>Mặc định</b>
                                    }
                                </label>
                            }
                        }
                        else
                        {
                            <div class="checkout-empty-address">
                                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                <div>
                                    <strong>Chưa có địa chỉ giao hàng</strong>
                                    <p>Thêm địa chỉ để có thể tiếp tục đặt hàng.</p>
                                </div>
                            </div>
                        }
                        <button type="button" class="checkout-add-address"
                                data-bs-toggle="modal" data-bs-target="#addAddressModal">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            Thêm địa chỉ mới
                        </button>
                    </div>
                </section>

                <section class="checkout-section" aria-labelledby="payment-method-title">
                    <div class="checkout-section-heading">
                        <span>02</span>
                        <div>
                            <h2 id="payment-method-title">Phương thức thanh toán</h2>
                            <p>Chọn một phương thức đang khả dụng.</p>
                        </div>
                    </div>
                    <div class="checkout-payment-list">
                        @foreach (var method in Model.PaymentMethods)
                        {
                            <label class="checkout-choice-card payment">
                                <input type="radio" name="paymentMethodId"
                                       value="@method.IdphuongThucThanhToan" required
                                       checked="@(method.IdphuongThucThanhToan == 1)" />
                                <span class="checkout-choice-indicator" aria-hidden="true"></span>
                                <i class="bi bi-cash-coin" aria-hidden="true"></i>
                                <span>
                                    <strong>@method.TenPhuongThuc</strong>
                                    <small>Thông tin thanh toán được xác nhận khi đặt hàng.</small>
                                </span>
                            </label>
                        }
                    </div>
                </section>
            </div>

            <aside class="checkout-summary" aria-labelledby="checkout-summary-title">
                <p class="section-kicker">YOUR ORDER</p>
                <h2 id="checkout-summary-title">Đơn hàng</h2>
                <div class="checkout-order-items">
                    @foreach (var item in Model.CartItems)
                    {
                        <article>
                            <img src="@item.AnhDaiDien" alt="@item.TenSanPham" />
                            <div>
                                <h3>@item.TenSanPham</h3>
                                <p>@item.TenMau / @item.TenKichThuoc · SL @item.SoLuong</p>
                            </div>
                            <strong>@item.ThanhTien.ToString("N0") ₫</strong>
                        </article>
                    }
                </div>

                <div class="checkout-coupon">
                    <label for="coupon-code">Mã giảm giá</label>
                    <div>
                        <input type="text" id="coupon-code" class="form-control"
                               placeholder="Nhập mã" autocomplete="off" />
                        <button class="btn btn-outline-dark" type="button" id="apply-coupon-btn">
                            Áp dụng
                        </button>
                    </div>
                    <p id="coupon-message" aria-live="polite"></p>
                </div>

                <dl class="checkout-totals">
                    <div><dt>Tạm tính</dt><dd>@Model.Subtotal.ToString("N0") ₫</dd></div>
                    <div><dt>Phí vận chuyển</dt><dd>@Model.ShippingFee.ToString("N0") ₫</dd></div>
                    <div class="text-success"><dt>Giảm giá</dt><dd id="discount-amount">- @Model.Discount.ToString("N0") ₫</dd></div>
                    <div class="checkout-grand-total"><dt>Tổng thanh toán</dt><dd id="total-amount">@Model.Total.ToString("N0") ₫</dd></div>
                </dl>

                <button type="submit" class="btn btn-dark w-100 checkout-submit" id="place-order-button">
                    <span>Đặt hàng</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
                <p class="checkout-security-note">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    Giá trị đơn hàng được xác thực trên máy chủ.
                </p>
            </aside>
        </div>
    </form>
</div>

<partial name="_AddAddressModalPartial" model="newAddressModel" />
