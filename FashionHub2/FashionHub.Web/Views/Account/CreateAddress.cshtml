@model FashionHub.Web.ViewModels.Account.AddressManagementViewModel
@{
    ViewData["Title"] = "Thêm địa chỉ mới";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Thêm địa chỉ mới</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateAddress" method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TenNguoiNhan" class="form-label"></label>
                                <input asp-for="TenNguoiNhan" class="form-control" />
                                <span asp-validation-for="TenNguoiNhan" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SoDienThoai" class="form-label"></label>
                                <input asp-for="SoDienThoai" class="form-control" />
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="ChiTiet" class="form-label"></label>
                                <input asp-for="ChiTiet" class="form-control" placeholder="Số nhà, tên đường..." />
                                <span asp-validation-for="ChiTiet" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mb-3">
                                <partial name="_VietnamAddressFieldsPartial" model="Model" />
                            </div>

                            <div class="col-12 mb-3">
                                <div class="form-check">
                                    <input asp-for="LaMacDinh" class="form-check-input" />
                                    <label asp-for="LaMacDinh" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>Lưu địa chỉ
                            </button>
                            <a asp-action="Addresses" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
