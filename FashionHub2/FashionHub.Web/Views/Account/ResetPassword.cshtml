@model FashionHub.Web.ViewModels.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <a asp-controller="Home" asp-action="Index" class="auth-logo" aria-label="OWE">OWE</a>
        <p>Tạo mật khẩu mới cho tài khoản</p>
    </div>

    <div class="card border-0 shadow-lg">
        <div class="card-body p-4 p-md-5">
            <div class="auth-heading text-center mb-4">
                <span class="auth-eyebrow">New password</span>
                <h1>Đặt lại mật khẩu</h1>
                <p>Sử dụng ít nhất 8 ký tự cho mật khẩu mới.</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="auth-form">
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="NewPassword"
                           class="form-control"
                           placeholder="Mật khẩu mới"
                           autocomplete="new-password"
                           autofocus />
                    <label asp-for="NewPassword">Mật khẩu mới</label>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           placeholder="Xác nhận mật khẩu"
                           autocomplete="new-password" />
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 auth-submit">
                    Cập nhật mật khẩu
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
