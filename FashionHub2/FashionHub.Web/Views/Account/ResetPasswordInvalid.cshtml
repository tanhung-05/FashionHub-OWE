@{
    ViewData["Title"] = "Liên kết không hợp lệ";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <a asp-controller="Home" asp-action="Index" class="auth-logo" aria-label="OWE">OWE</a>
        <p>Khôi phục quyền truy cập tài khoản</p>
    </div>

    <div class="card border-0 shadow-lg">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="auth-heading mb-4">
                <span class="auth-eyebrow">Link expired</span>
                <h1>Liên kết không hợp lệ</h1>
                <p>Liên kết đã hết hạn, đã được sử dụng hoặc không chính xác.</p>
            </div>

            <a class="btn btn-primary w-100 auth-submit" asp-action="ForgotPassword">
                Yêu cầu liên kết mới
            </a>
        </div>
    </div>
</div>
