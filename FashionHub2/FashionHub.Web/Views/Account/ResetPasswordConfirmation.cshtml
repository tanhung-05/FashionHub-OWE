@{
    ViewData["Title"] = "Đổi mật khẩu thành công";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <a asp-controller="Home" asp-action="Index" class="auth-logo" aria-label="OWE">OWE</a>
        <p>Tài khoản của bạn đã được bảo vệ</p>
    </div>

    <div class="card border-0 shadow-lg">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="auth-heading mb-4">
                <span class="auth-eyebrow">Password updated</span>
                <h1>Đã đổi mật khẩu</h1>
                <p>Bạn có thể đăng nhập bằng mật khẩu mới ngay bây giờ.</p>
            </div>

            <a class="btn btn-primary w-100 auth-submit" asp-action="Login">
                Đăng nhập
            </a>
        </div>
    </div>
</div>
