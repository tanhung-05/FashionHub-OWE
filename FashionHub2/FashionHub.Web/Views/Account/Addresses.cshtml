@model IEnumerable<FashionHub.Web.Models.Generated.DiaChi>
@{
    ViewData["Title"] = "Quản lý địa chỉ";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3><i class="bi bi-geo-alt me-2"></i>Địa chỉ giao hàng</h3>
                <a asp-action="CreateAddress" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>Thêm địa chỉ mới
                </a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-geo-alt text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-3">Bạn chưa có địa chỉ nào</p>
                    <a asp-action="CreateAddress" class="btn btn-primary">Thêm địa chỉ đầu tiên</a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var address in Model)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 @(address.LaMacDinh == true ? "border-primary" : "")">
                                <div class="card-body">
                                    @if (address.LaMacDinh == true)
                                    {
                                        <span class="badge bg-primary mb-2">Mặc định</span>
                                    }
                                    <h6 class="card-title fw-bold">@address.TenNguoiNhan</h6>
                                    <p class="card-text small text-muted mb-2">
                                        <i class="bi bi-telephone me-1"></i>@address.SoDienThoai
                                    </p>
                                    <p class="card-text small">
                                        @address.ChiTiet, @address.PhuongXa, @address.QuanHuyen, @address.TinhThanh
                                    </p>
                                </div>
                                <div class="card-footer bg-white border-top-0 d-flex gap-2">
                                    <a asp-action="EditAddress" asp-route-id="@address.IddiaChi" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil me-1"></i>Sửa
                                    </a>

                                    @if (address.LaMacDinh != true)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" onclick="setDefault(@address.IddiaChi)">
                                            <i class="bi bi-check2 me-1"></i>Đặt mặc định
                                        </button>
                                    }

                                    <form asp-action="DeleteAddress" asp-route-id="@address.IddiaChi" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa địa chỉ này?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash me-1"></i>Xóa
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="mt-4">
                <a asp-action="Profile" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại trang cá nhân
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function setDefault(addressId) {
    if (!confirm('Đặt làm địa chỉ mặc định?')) return;
    
    fetch('/Account/SetDefaultAddress/' + addressId, {
        method: 'POST',
        headers: {
            'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert(data.message || 'Có lỗi xảy ra');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Có lỗi xảy ra');
    });
}
</script>
}
