@model IEnumerable<FashionHub.Web.Models.Generated.DiaChi>
@{
    ViewData["Title"] = "Địa chỉ giao hàng";
}

<div class="account-page">
    <header class="account-page-heading">
        <div>
            <p class="section-kicker">MY OWE</p>
            <h1>Địa chỉ giao hàng</h1>
            <p>Quản lý thông tin người nhận dùng khi thanh toán.</p>
        </div>
        <a asp-action="CreateAddress" class="btn btn-dark">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Thêm địa chỉ
        </a>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (!Model.Any())
    {
        <div class="account-empty-state">
            <i class="bi bi-geo-alt" aria-hidden="true"></i>
            <h2>Chưa có địa chỉ nào</h2>
            <p>Thêm địa chỉ đầu tiên để thanh toán nhanh hơn.</p>
            <a asp-action="CreateAddress" class="btn btn-dark">Thêm địa chỉ</a>
        </div>
    }
    else
    {
        <div class="address-grid">
            @foreach (var address in Model)
            {
                <article class="address-item @(address.LaMacDinh == true ? "is-default" : "")">
                    <header>
                        <div>
                            <h2>@address.TenNguoiNhan</h2>
                            <a href="tel:@address.SoDienThoai">@address.SoDienThoai</a>
                        </div>
                        @if (address.LaMacDinh == true)
                        {
                            <span>Mặc định</span>
                        }
                    </header>
                    <p>@address.ChiTiet, @address.PhuongXa, @address.QuanHuyen, @address.TinhThanh</p>
                    <footer>
                        <a asp-action="EditAddress" asp-route-id="@address.IddiaChi">
                            <i class="bi bi-pencil" aria-hidden="true"></i>Sửa
                        </a>
                        @if (address.LaMacDinh != true)
                        {
                            <button type="button" class="js-set-default-address"
                                    data-address-id="@address.IddiaChi">
                                <i class="bi bi-check2-circle" aria-hidden="true"></i>Đặt mặc định
                            </button>
                        }
                        <form asp-action="DeleteAddress" asp-route-id="@address.IddiaChi"
                              method="post" class="js-delete-address-form">
                            <button type="submit">
                                <i class="bi bi-trash3" aria-hidden="true"></i>Xóa
                            </button>
                        </form>
                    </footer>
                </article>
            }
        </div>
    }

    <a asp-action="Profile" class="account-back-link">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        Quay lại hồ sơ
    </a>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.js-set-default-address').forEach(function (button) {
                button.addEventListener('click', async function () {
                    const confirmed = await window.AppAlert.Confirm(
                        'Đặt địa chỉ này làm địa chỉ mặc định?');
                    if (!confirmed) {
                        return;
                    }

                    button.disabled = true;
                    fetch('/Account/SetDefaultAddress/' + button.dataset.addressId, {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': window.AppUtilities.getRequestVerificationToken(),
                            'Accept': 'application/json'
                        }
                    })
                        .then(function (response) {
                            if (!response.ok) {
                                throw new Error('HTTP ' + response.status);
                            }
                            return response.json();
                        })
                        .then(function (response) {
                            if (!response.success) {
                                throw new Error(response.message || 'Không thể đặt địa chỉ mặc định.');
                            }
                            window.location.reload();
                        })
                        .catch(function () {
                            button.disabled = false;
                            window.AppAlert.ShowError('Không thể đặt địa chỉ mặc định.');
                        });
                });
            });

            document.querySelectorAll('.js-delete-address-form').forEach(function (form) {
                form.addEventListener('submit', async function (event) {
                    event.preventDefault();
                    const confirmed = await window.AppAlert.Confirm(
                        'Xóa địa chỉ này khỏi tài khoản?', { okText: 'Xóa địa chỉ' });
                    if (confirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
