@model FashionHub.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-card">
    <div class="auth-brand">
        <a asp-controller="Home" asp-action="Index" class="auth-logo" aria-label="OWE">OWE</a>
        <p>Thời trang tối giản cho phong cách hiện đại</p>
    </div>

    <div class="card border-0 shadow-lg">
        <div class="card-body p-4 p-md-5">
            <div class="auth-heading text-center mb-4">
                <span class="auth-eyebrow">Welcome back</span>
                <h1>Đăng nhập</h1>
                <p>Tiếp tục mua sắm và quản lý đơn hàng của bạn.</p>
            </div>

            <form asp-action="Login" asp-controller="Account" asp-route-returnUrl="@returnUrl" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
                    <label asp-for="Email">Email</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control" placeholder="Mật khẩu" autocomplete="current-password" />
                    <label asp-for="Password">Mật khẩu</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small">Ghi nhớ đăng nhập</label>
                    </div>
                    <a class="auth-link small" href="#">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn btn-primary w-100 auth-submit">Đăng nhập</button>
            </form>
        </div>

        <div class="card-footer text-center bg-white border-0 px-4 pb-4">
            <span class="text-muted small">Chưa có tài khoản?</span>
            <a class="auth-link small fw-bold" asp-action="Register" asp-route-returnUrl="@returnUrl">Đăng ký ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}