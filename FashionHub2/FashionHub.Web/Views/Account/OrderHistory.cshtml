@model List<FashionHub.Web.ViewModels.Account.OrderHistoryViewModel>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var statusFilter = ViewBag.StatusFilter;
    var totalOrders = ViewBag.TotalOrders ?? 0;
    var statuses = ViewBag.Statuses as List<FashionHub.Web.Models.Generated.TrangThaiDonHang> ?? new();
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">Lịch sử đơn hàng</h2>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Filter -->
            <div class="card mb-4">
                <div class="card-body">
                    <form method="get" asp-action="OrderHistory" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Trạng thái</label>
                            <select name="statusFilter" class="form-select">
                                <option value="">Tất cả</option>
                                @foreach (var status in statuses)
                                {
                                    <option value="@status.IdtrangThai" selected="@(statusFilter == status.IdtrangThai)">
                                        @status.TenTrangThai
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-8 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="bi bi-funnel"></i> Lọc
                            </button>
                            <a asp-action="OrderHistory" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-clockwise"></i> Đặt lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Orders List -->
            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Bạn chưa có đơn hàng nào.
                    <a asp-controller="Products" asp-action="Index" class="alert-link">Khám phá sản phẩm ngay</a>
                </div>
            }
            else
            {
                <div class="row row-cols-1 g-3">
                    @foreach (var order in Model)
                    {
                        <div class="col">
                            <div class="card">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-2">
                                            <h6 class="mb-1">Đơn hàng #@order.IddonHang</h6>
                                            <small class="text-muted">
                                                @(order.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                            </small>
                                        </div>
                                        <div class="col-md-2">
                                            <span class="badge bg-@order.MauTrangThai">@order.TrangThai</span>
                                        </div>
                                        <div class="col-md-2">
                                            <small class="text-muted d-block">Số lượng</small>
                                            <strong>@order.SoLuongSanPham sản phẩm</strong>
                                        </div>
                                        <div class="col-md-3">
                                            <small class="text-muted d-block">Tổng tiền</small>
                                            <strong class="text-danger">@order.TongThanhToan.ToString("N0") ₫</strong>
                                        </div>
                                        <div class="col-md-3 text-end">
                                            <a asp-action="OrderDetail" asp-route-id="@order.IddonHang" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> Xem chi tiết
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Order history pagination" class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="OrderHistory" 
                                   asp-route-page="@(currentPage - 1)" 
                                   asp-route-statusFilter="@statusFilter">Trước</a>
                            </li>

                            @for (var i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="OrderHistory" 
                                       asp-route-page="@i" 
                                       asp-route-statusFilter="@statusFilter">@i</a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="OrderHistory" 
                                   asp-route-page="@(currentPage + 1)" 
                                   asp-route-statusFilter="@statusFilter">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }

                <div class="text-center text-muted mt-3">
                    <small>Hiển thị @Model.Count trong tổng số @totalOrders đơn hàng</small>
                </div>
            }
        </div>
    </div>
</div>