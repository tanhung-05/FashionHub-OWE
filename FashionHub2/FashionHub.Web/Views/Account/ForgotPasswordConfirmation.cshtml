@{
    ViewData["Title"] = "Kiểm tra email";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <a asp-controller="Home" asp-action="Index" class="auth-logo" aria-label="OWE">OWE</a>
        <p>Khôi phục quyền truy cập tài khoản</p>
    </div>

    <div class="card border-0 shadow-lg">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="auth-heading mb-4">
                <span class="auth-eyebrow">Email sent</span>
                <h1>Kiểm tra email</h1>
                <p>
                    Nếu email tồn tại trong hệ thống, hướng dẫn đặt lại mật khẩu
                    đã được gửi. Liên kết chỉ có hiệu lực trong thời gian giới hạn.
                </p>
            </div>

            <a class="btn btn-primary w-100 auth-submit" asp-action="Login">
                Về trang đăng nhập
            </a>
        </div>
    </div>
</div>
